#!/bin/bash
# SPDX-License-Identifier: MIT
# ingot-fp-stage: run the Solana Saga's (ingot) vendor fingerprint stack, stage
# S3, in a minimal chroot ON THE PHONE, as root, in the foreground:
# qseecomd (the QSEE listener services) with our stub RPMB and SSD listener
# libraries, then a host program that opens the vendor fingerprint HAL, which
# loads the btlap64 trusted app and talks to the sensor.
#
#   ingot-fp-stage check     --image DIR --bin DIR   preconditions; changes nothing
#   ingot-fp-stage audit     --image DIR --bin DIR   build the chroot in a private
#                                    namespace, run every safety check on it,
#                                    print its /dev and mounts, start nothing
#   ingot-fp-stage listeners --image DIR --bin DIR   qseecomd, until ^C
#   ingot-fp-stage hal       --image DIR --bin DIR [--seconds N] [--hal-root]
#                                    qseecomd, then (once its listeners are
#                                    registered) omamobile-fp-halhost open
#                                    [--seconds N], as uid/gid 1000 (system;
#                                    --hal-root: as root); then the sensor
#                                    driver's chipid/version and the kernel log.
#                                    PASS for S3: chipid 5f83
#   ingot-fp-stage bridge    --image DIR --bin DIR [--enroll-timeout SEC]
#                                    qseecomd, then omamobile-fp-bridge-ingot
#                                    as uid/gid 1000 (it hosts the HAL itself),
#                                    serving fprintd's socket on the host at
#                                    /run/omamobile-fp/sock/bridge.sock (root,
#                                    0600), until stopped. S4 and later.
#                                    --enroll-timeout: the HAL's budget for a
#                                    whole enrolment (the bridge's default,
#                                    Android's, is 60 s)
#   ingot-fp-stage stop              stop a running stage in order (TERM to
#                                    its namespace's PID 1) and wait for it
#   ingot-fp-stage run       --image DIR --bin DIR [--as-system] -- CMD...
#                                    an Android binary in the same environment:
#                                    inside a running listeners/hal stage if
#                                    there is one, else in a fresh chroot
#   Options: --state DIR (default /var/lib/omamobile-fp-ingot); for audit,
#            listeners, hal and bridge, --rpmb-writes (the RPMB listener
#            forwards TrustZone's authenticated writes to the chip; without
#            it, it refuses every one)
#
# --image is the tree tools/extract-fingerprint-vendor-ingot made (vendor/,
# system/, apex/; the vendor's, never shipped). --bin holds our builds:
# librpmb.so and libssd.so (our listener libraries: they register the RPMB
# and SSD listeners; libssd.so opens no device, librpmb.so opens exactly
# the one node this script hands it, /dev/rpmb-wlu, and passes TrustZone's
# RPMB frames through to it unmodified, see SAFETY; the old stub answered
# every request "failed"),
# omamobile-fp-halhost (for hal), omamobile-fp-bridge-ingot (for bridge), and
# optionally omamobile-fp-shim.so (the preload shim: properties and logging;
# preloaded only if present).
#
# SAFETY (enforced below; check and every start verify and print it):
#   - The chroot's /dev is a fresh tmpfs holding ONLY these character devices,
#     made with mknod from the host's own device numbers: null, zero, full,
#     random, urandom, qseecom, blfp, dma_heap/qcom,qseecom +
#     dma_heap/qcom,qseecom-ta (both the host's dma_heap/default_cma_region),
#     and rpmb-wlu, the bsg node of the UFS RPMB well-known LU (rpmb_find:
#     the one SCSI device of LUN 49476, UFS W-LUN 0xC4, whose sysfs path
#     runs through the UFS host controller and whose type is 30; its bsg
#     node's numbers, root's, 0600). No block device, no other bsg/sg node,
#     no /dev/block, no host /dev bind; the audit refuses any other entry in
#     /dev (rpmb-wlu with other numbers or another owner or mode too), and
#     any block or character node anywhere else in the chroot.
#   - No partition is mounted or opened: /data, /mnt/vendor/persist and
#     /persist inside are directories under the state directory on the
#     phone's own root file system, bind-mounted (so libdrmfs finds the
#     persist mount in /proc/mounts). The audit refuses any mount in the
#     chroot outside a fixed list, and any whose file system is not tmpfs,
#     proc or the one holding --image, --bin or the state directory.
#   - The stubs take precedence: BIN/librpmb.so and BIN/libssd.so are bind-
#     mounted read-only over /vendor/lib64/{librpmb,libssd}.so, and before
#     anything starts the files seen there inside the namespace must have the
#     stubs' sha256, differ from the vendor's, and contain no RPMB/SSD
#     device path (/dev/block, ufs-bsg, mmcblk, /dev/sg, by-name/ssd): the
#     RPMB listener takes its one node's path from the environment.
#   - Every Android process runs with mknod, sys_admin, sys_module, sys_boot
#     and sys_time out of its capability bounding set: even as root it
#     cannot make a device node, mount, or set the clock. Every one but
#     qseecomd also loses sys_rawio. qseecomd keeps it: the kernel wants
#     CAP_SYS_RAWIO at each SG_IO on a bsg node for SECURITY PROTOCOL IN/OUT,
#     and qseecomd, dropping to uid 1000 by itself, keeps exactly
#     sys_rawio and block_suspend (PR_SET_KEEPCAPS, setuid, capset); its
#     only device with a use for it is /dev/rpmb-wlu.
#   - /sys is a tmpfs with copies of the two clock uevent files libqisl
#     reads; the host's /sys is not visible inside.
#   - bridge (and audit) only: the one host directory the chroot sees is
#     the bridge's socket directory, /run/omamobile-fp/sock (the path
#     fprintd's drop-in and omamobile-fp-ctl use on the Pixel), made empty
#     by this script and bind-mounted at /dev/socket/omamobile-fp. The
#     audit refuses that mount unless it is exactly this directory, and any
#     entry in it but the bridge's socket. The directory belongs to uid
#     1000 only while the bridge starts (it binds its socket there); once
#     the socket is up, both are root's again (directory 0700, socket 0600,
#     as on the Pixel): a listening socket keeps working, and only root
#     (fprintd, omamobile-fp-ctl) can connect. A stop removes the directory.
#     The bridge's own state is /data/vendor/omamobile-fp (secret,
#     gatekeeper handle), its HAL's templates /data/vendor_de/0/fpdata:
#     both under the state directory, uid 1000, 0700/0770.
#   - The RPMB pass-through (librpmb.so, in qseecomd's listener thread)
#     forwards TrustZone's RPMB frames unmodified to /dev/rpmb-wlu (SG_IO,
#     SECURITY PROTOCOL OUT/IN) and returns the chip's replies unmodified.
#     It opens the node once, as root, in its init, before qseecomd drops to
#     uid 1000 (the node stays root's, 0600: nothing else of uid 1000's can
#     open it). Every authenticated write (request 0x103) is refused without
#     touching the device unless --rpmb-writes is given (then it forwards
#     them, and check and the start say so); a key-programming request
#     (type 0x0001) is always refused. Its environment, set for every
#     Android process: OMAMOBILE_RPMB_DEV=/dev/rpmb-wlu, OMAMOBILE_RPMB_LOG,
#     OMAMOBILE_RPMB_WRITES (0 or 1), OMAMOBILE_RPMB_FPT (frames per
#     transfer, the geometry descriptor's rpmb_rw_size) and
#     OMAMOBILE_RPMB_SECTORS (512-byte sectors, the W-LU's unit descriptor).
#     Its audit log, one line per request (never a data block), is
#     /data/vendor/omamobile-rpmb/passthrough.log, opened as root before the
#     drop too: $STATE/data/vendor/omamobile-rpmb on the host, root's, 0700,
#     holding only regular files, root's, 0600. check and the audit refuse
#     it otherwise, never repair it: uid 1000 owns data/vendor and could
#     leave its own directory or a link there. A start rotates the log
#     once it is past RPMB_LOG_ROTATE_BYTES (passthrough.log.1, .2; the
#     oldest dropped), before the listener opens it.
#   - The fd audit (audit_fds), once the listeners are registered and again
#     once the HAL host or the bridge's socket is up: every process of the
#     namespace may hold only sockets, pipes, anonymous inodes, the
#     allowlisted character devices, and files under the chroot, --image,
#     --bin or the state directory (the runner's own helpers also $RUN,
#     this script, and what they inherited as stdin/out/err). Any block
#     device, any other character device or file, /dev/rpmb-wlu held by any
#     process but qseecomd, and any file of the pass-through's directory but
#     passthrough.log stops the stage.
#   Left as is: the chroot's /proc shows the namespace's PID 1 (this
#   script), whose /proc/1/root is the host's root; a root process inside
#   could deliberately walk out through it (no vendor code here does).
#   qseecomd drops to uid 1000 by itself, and uid 1000 is the phone's user:
#   that user can signal the Android processes while they run.
#
# Network: the host's namespace (the sensor driver's netlink socket, protocol
# 26, exists only in the initial one). Mount and PID namespaces are private:
# when this script (the namespace's PID 1) exits, every Android process dies
# with it. ^C/TERM (or ingot-fp-stage stop) stops the HAL host or the bridge
# first, then qseecomd; the kernel then unregisters the listeners and unloads
# the trusted app as their files close.
#
# Logging: without logd, bionic's liblog sends to /dev/socket/logdw; a
# reader (python3) on that datagram socket prints each line prefixed with
# the sending process's name. With the shim, liblog's output goes to stderr
# instead. Everything, this script's own lines included, also lands in
# $RUN/stage.log (truncated at each start).
#
# Needs on the phone: bash, util-linux (unshare, nsenter, setpriv, setsid,
# mount, findmnt, flock, dmesg), coreutils (chroot, sha256sum, stat, mknod,
# install), findutils, grep, sed, python3 (the log reader; without it, and
# without the shim, the Android processes' logs are lost), kmod (modprobe,
# only if the qseecom or betterlife modules are not loaded yet). The modules
# qcom_qseecom_user and betterlife-fp.
#
# Shipped by omamobile-fingerprint as /usr/lib/omamobile-fp-ingot/ingot-fp-stage
# (tools/ingot-fp-stage links here); its unit omamobile-fp-ingot.service,
# on by default once tools/ingot-fp-provision has put the vendor's files in
# /usr/lib/omamobile-fp-ingot/root, runs the bridge stage on
# /usr/lib/omamobile-fp-ingot/{root,bin} with --rpmb-writes at every boot.
#
# Modules: a start (not check) loads qcom_qseecom_user when /dev/qseecom is
# missing, and betterlife-fp for hal and bridge when /dev/blfp is, BEFORE
# its precondition check: nothing else loads them at boot.
#
# Tests: tools/ingot-fp-stage-test. OMAMOBILE_FP_TEST_ROOT (host /dev, /sys
# and /run under a fake tree; "device nodes" there are regular files
# reading "c MAJ:MIN", copied instead of mknod), OMAMOBILE_FP_TEST_INJECT
# (a fault for the audit to catch) and OMAMOBILE_FP_TEST_MODPROBE (the
# modprobe to run against the fake tree; none without it) are honoured only
# with OMAMOBILE_FP_TEST=1.
set -euo pipefail

say() {
  printf 'ingot-fp: %s\n' "$*" >&2
  [[ -z ${SAYLOG:-} ]] || printf 'ingot-fp: %s\n' "$*" >> "$LOG" 2>/dev/null || true
}
die() { say "error: $*"; exit 1; }
usage() { sed -n '/^#   ingot-fp-stage check/,/^#$/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# --- Paths and options -------------------------------------------------------

TROOT=
[[ ${OMAMOBILE_FP_TEST:-} == 1 && -n ${OMAMOBILE_FP_TEST_ROOT:-} ]] && TROOT=$OMAMOBILE_FP_TEST_ROOT
HDEV=$TROOT/dev                      # the host's device nodes
HSYS=$TROOT/sys                      # the host's sysfs
RUN=$TROOT/run/omamobile-fp-ingot
ROOT=$RUN/root
NSPID=$RUN/ns.pid
LOG=$RUN/stage.log
SYSFP=$HSYS/devices/platform/fingerprint
# The bridge's socket: the host path the Pixel uses (fprintd's drop-in,
# omamobile-fp-ctl), and where the chroot sees it.
SOCKDIR=$TROOT/run/omamobile-fp/sock
SOCK=$SOCKDIR/bridge.sock
CSOCKDIR=/dev/socket/omamobile-fp
# The bridge's own state directory, in the chroot
BRIDGE_STATE=/data/vendor/omamobile-fp
# The RPMB pass-through's directory, in the chroot, and its one file
RPMB_DIR=/data/vendor/omamobile-rpmb
RPMB_LOG=$RPMB_DIR/passthrough.log
# A start rotates the log past this size (about 5000 requests; a day of
# unlocking is a few hundred), keeping two old ones
RPMB_LOG_ROTATE_BYTES=$((1024 * 1024))
# The RPMB node in the chroot (rpmb_find maps it to the host's)
RPMB_NODE='rpmb-wlu'
# The UFS RPMB well-known LU (W-LUN 0xC4) as a SCSI LUN: 0xC144, fixed by
# the kernel's UFS mapping (the host number may vary)
RPMB_LUN=49476
# Android's system user: qseecomd drops to it, the HAL runs as it. A user
# namespace in the tests maps only root.
SYS_ID=1000
[[ -n $TROOT ]] && SYS_ID=$(id -u)

# Host tools, resolved now: the Android processes get an Android PATH.
hostbin() { PATH=/usr/bin:/bin:/usr/sbin:/sbin command -v "$1" || true; }
CHROOT_BIN=$(hostbin chroot)
SETPRIV_BIN=$(hostbin setpriv)
SETSID_BIN=$(hostbin setsid)
PYTHON_BIN=$(hostbin python3)

# Out of every Android process's bounding set (see the header); qseecomd
# keeps sys_rawio for the RPMB listener's SG_IO.
DROP_CAPS=-mknod,-sys_admin,-sys_rawio,-sys_module,-sys_boot,-sys_time
DROP_CAPS_QSEECOMD=-mknod,-sys_admin,-sys_module,-sys_boot,-sys_time

# chroot path -> host node (under $HDEV). Nothing else enters /dev (but
# rpmb-wlu, whose host node rpmb_find resolves: added below).
declare -A NODES=(
  [null]=null [zero]=zero [full]=full [random]=random [urandom]=urandom
  [qseecom]=qseecom [blfp]=blfp
  [dma_heap/qcom,qseecom]=dma_heap/default_cma_region
  [dma_heap/qcom,qseecom-ta]=dma_heap/default_cma_region
)
# Nodes uid 1000 must open after qseecomd drops privileges (and the HAL).
SYS_NODES=" qseecom blfp dma_heap/qcom,qseecom dma_heap/qcom,qseecom-ta "
# Optional on the host: only the hal and bridge stages need the sensor.
OPT_NODES=" blfp "

# Strings no stub may contain: the vendor's RPMB/SSD device paths.
FORBIDDEN=(/dev/block ufs-bsg mmcblk /dev/sg /dev/0:0:0 by-name/ssd)

MODE=${1:-}; [[ -n $MODE ]] || usage
shift
# stop: TERM to the running stage's PID 1 (it stops its processes in order)
if [[ $MODE == stop ]]; then
  p=$(cat "$NSPID" 2>/dev/null || true)
  if ! [[ $p =~ ^[0-9]+$ ]] || ! kill -0 "$p" 2>/dev/null; then
    say "no stage running"; exit 0
  fi
  say "stopping the stage (PID $p)"
  kill -TERM "$p"
  for ((i = 0; i < 300; i++)); do kill -0 "$p" 2>/dev/null || { say "stopped"; exit 0; }; sleep 0.1; done
  die "the stage (PID $p) still runs after 30 s"
fi
IMAGE='' BIN='' STATE=/var/lib/omamobile-fp-ingot SECONDS_ARG='' HAL_ROOT=0 AS_SYSTEM=0 ENROLL_TIMEOUT=''
RPMB_WRITES=0
CMD=()
while (($#)); do
  case $1 in
    --image) IMAGE=${2:?}; shift ;;
    --bin) BIN=${2:?}; shift ;;
    --state) STATE=${2:?}; shift ;;
    --seconds) SECONDS_ARG=${2:?}; shift ;;
    --enroll-timeout) ENROLL_TIMEOUT=${2:?}; shift ;;
    --hal-root) HAL_ROOT=1 ;;
    --as-system) AS_SYSTEM=1 ;;
    --rpmb-writes) RPMB_WRITES=1 ;;
    --) shift; CMD=("$@"); break ;;
    -h|--help) usage ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done
[[ -n $IMAGE && -n $BIN ]] || die "--image DIR and --bin DIR are required"
IMAGE=$(realpath -e -- "$IMAGE") || die "no such directory: --image"
BIN=$(realpath -e -- "$BIN") || die "no such directory: --bin"
[[ $STATE == /* ]] || die "--state must be an absolute path"
case $STATE in /dev|/dev/*|/proc|/proc/*|/sys|/sys/*|/run/omamobile-fp-ingot*|/run/omamobile-fp|/run/omamobile-fp/*|/) die "--state $STATE: not there" ;; esac
[[ -z $SECONDS_ARG || $SECONDS_ARG =~ ^[0-9]+$ ]] || die "--seconds takes a number"
[[ -z $ENROLL_TIMEOUT || $ENROLL_TIMEOUT =~ ^[1-9][0-9]{0,4}$ ]] || die "--enroll-timeout takes a number of seconds (1-99999)"
[[ -z $ENROLL_TIMEOUT || $MODE == bridge ]] || die "--enroll-timeout is for the bridge stage"
case $RPMB_WRITES:$MODE in
  0:*|1:audit|1:listeners|1:hal|1:bridge) ;;
  *) die "--rpmb-writes is for the audit, listeners, hal and bridge stages" ;;
esac

SHIM=$BIN/omamobile-fp-shim.so
HALHOST=$BIN/omamobile-fp-halhost
BRIDGE=$BIN/omamobile-fp-bridge-ingot

# --- Device nodes ------------------------------------------------------------

# "MAJ:MIN" of a character device (a fake one in the tests), or fail.
node_id() {
  local t mm
  if [[ -n $TROOT ]]; then
    [[ -f $1 && ! -L $1 ]] || return 1
    read -r t mm < "$1" || return 1
    [[ $t == c && $mm =~ ^[0-9]+:[0-9]+$ ]] || return 1
    echo "$mm"
    return 0
  fi
  [[ -c $1 && ! -L $1 ]] || return 1
  read -r t mm < <(stat -c '%t %T' -- "$1") || return 1
  echo "$((16#$t)):$((16#$mm))"
}

# A sysfs hex number ("0xF8") as decimal, or fail.
sysfs_hex() {
  local v
  { read -r v < "$1"; } 2>/dev/null || return 1
  # leading zeros as the descriptors print them ("0x0000000000010000")
  [[ $v =~ ^0x0*([0-9a-fA-F]{0,15})$ ]] || return 1
  v=${BASH_REMATCH[1]}
  echo "$((16#${v:-0}))"
}

# The UFS RPMB well-known LU, from the host's sysfs: the one SCSI device of
# LUN $RPMB_LUN whose path runs through a UFS host controller and whose
# type is 30 (well-known), its bsg node (RPMB_HOST, under $HDEV; RPMB_ID),
# the frames per transfer (the controller's geometry descriptor) and its
# size in 512-byte sectors (its unit descriptor). Fails with RPMB_WHY.
RPMB_HOST='' RPMB_ID='' RPMB_FPT='' RPMB_SECTORS='' RPMB_SYS='' RPMB_WHY=''
rpmb_find() {
  local d name real t seen='' u b n bc bs
  local -a found=() bsg=()
  for d in "$HSYS"/class/scsi_device/*/device; do
    name=${d%/device}; name=${name##*/}
    [[ $name =~ ^[0-9]+:[0-9]+:[0-9]+:$RPMB_LUN$ ]] || continue
    real=$(readlink -f -- "$d") || continue
    [[ $real == *ufshc* ]] || { seen+=" $name (not under a ufshc)"; continue; }
    { read -r t < "$real/type"; } 2>/dev/null || t=unreadable
    [[ $t == 30 ]] || { seen+=" $name (type $t)"; continue; }
    found+=("$real")
  done
  if ((${#found[@]} != 1)); then
    RPMB_WHY="${#found[@]} SCSI devices of LUN $RPMB_LUN, type 30, under a ufshc in $HSYS/class/scsi_device, want 1${seen:+; also seen:$seen}"
    return 1
  fi
  real=${found[0]}
  RPMB_SYS=$real
  for d in "$real"/bsg/*/dev; do [[ -f $d ]] && bsg+=("$d"); done
  ((${#bsg[@]} == 1)) || { RPMB_WHY="$real has ${#bsg[@]} bsg nodes, want 1"; return 1; }
  b=${bsg[0]%/dev}; b=${b##*/}
  [[ $b =~ ^[0-9]+:[0-9]+:[0-9]+:[0-9]+$ ]] || { RPMB_WHY="$real's bsg node is named '$b'"; return 1; }
  { read -r t < "${bsg[0]}"; } 2>/dev/null || t=
  [[ $t =~ ^[0-9]+:[0-9]+$ ]] || { RPMB_WHY="${bsg[0]} reads '$t', not MAJ:MIN"; return 1; }
  n=$(node_id "$HDEV/bsg/$b") || { RPMB_WHY="no character device $HDEV/bsg/$b"; return 1; }
  [[ $n == "$t" ]] || { RPMB_WHY="$HDEV/bsg/$b is c $n, sysfs says $t"; return 1; }
  # the UFS host controller: the nearest directory up named *.ufshc
  u=$real
  while [[ -n $u && ${u##*/} != *.ufshc ]]; do u=${u%/*}; done
  [[ -n $u ]] || { RPMB_WHY="no *.ufshc directory above $real"; return 1; }
  RPMB_FPT=$(sysfs_hex "$u/geometry_descriptor/rpmb_rw_size") || RPMB_FPT=0
  ((RPMB_FPT > 0)) ||
    { RPMB_WHY="$u/geometry_descriptor/rpmb_rw_size unreadable, not a hex number or 0"; return 1; }
  bc=$(sysfs_hex "$real/unit_descriptor/logical_block_count") || bc=0
  ((bc > 0)) ||
    { RPMB_WHY="$real/unit_descriptor/logical_block_count unreadable, not a hex number or 0"; return 1; }
  bs=$(sysfs_hex "$real/unit_descriptor/logical_block_size") || bs=0
  ((bs >= 8 && bs <= 20)) ||
    { RPMB_WHY="$real/unit_descriptor/logical_block_size unreadable, not a hex number or out of range"; return 1; }
  (((bc << bs) % 512 == 0)) || { RPMB_WHY="$bc blocks of 2^$bs bytes is no whole number of 512-byte sectors"; return 1; }
  RPMB_SECTORS=$(((bc << bs) / 512))
  RPMB_ID=$t
  RPMB_HOST=bsg/$b
}
rpmb_find || true
[[ -z $RPMB_HOST ]] || NODES[$RPMB_NODE]=$RPMB_HOST

# Create the chroot node $1 (relative to its /dev) as the host's.
make_node() {
  local name=$1 dst=$ROOT/dev/$1 id mode=0666 own=0
  id=$(node_id "$HDEV/${NODES[$name]}") || return 1
  [[ $SYS_NODES == *" $name "* ]] && { mode=0660; own=$SYS_ID; }
  # the RPMB listener opens it as root, before qseecomd drops to uid 1000
  [[ $name == "$RPMB_NODE" ]] && mode=0600
  mkdir -p "$(dirname "$dst")"
  if [[ -n $TROOT ]]; then
    printf 'c %s\n' "$id" > "$dst"
  else
    mknod -m "$mode" "$dst" c "${id%:*}" "${id#*:}"
  fi
  chown "$own:$own" "$dst"
  chmod "$mode" "$dst"
}

# --- Checks ------------------------------------------------------------------

sha() { sha256sum -- "$1" | cut -d' ' -f1; }

# A stub fit to be used: ours, not the vendor's, no device path in it (the
# RPMB listener opens only the node it is handed in its environment).
stub_ok() { # $1 file name
  local f=$BIN/$1 v=$IMAGE/vendor/lib64/$1 s ok=1
  [[ -f $f && ! -L $f ]] || { say "no stub $f (a regular file)"; return 1; }
  s=$(sha "$f")
  [[ -f $v && $(sha "$v") == "$s" ]] && { say "$f is the vendor's $1, not our stub"; ok=0; }
  for s in "${FORBIDDEN[@]}"; do
    grep -qaF -- "$s" "$f" && { say "$f contains \"$s\": not a stub"; ok=0; }
  done
  ((ok)) && say "stub $1: sha256 $(sha "$f" | cut -c1-16), not the vendor's, no device path"
  ((ok))
}

check() {
  local ok=1 n id t
  [[ $EUID -eq 0 ]] || { say "run as root"; ok=0; }
  [[ -x $CHROOT_BIN ]] || { say "no chroot(1) (coreutils)"; ok=0; }
  [[ -x $SETPRIV_BIN && -x $SETSID_BIN ]] || { say "no setpriv/setsid (util-linux)"; ok=0; }
  for t in unshare nsenter mount findmnt flock sha256sum mknod find; do
    [[ -n $(hostbin "$t") ]] || { say "no $t on the host"; ok=0; }
  done
  [[ -x $PYTHON_BIN ]] || say "no python3: no log reader, the Android processes' logs are lost unless the shim is used"
  for t in system/bin/linker64 apex/com.android.runtime/bin/linker64 vendor/bin/qseecomd \
      vendor/lib64/libQSEEComAPI.so vendor/lib64/librpmb.so vendor/lib64/libssd.so; do
    [[ -e $IMAGE/$t || -L $IMAGE/$t ]] || { say "no $t in $IMAGE (tools/extract-fingerprint-vendor-ingot)"; ok=0; }
  done
  [[ -f $IMAGE/vendor/lib64/hw/fingerprint.betterlife.so ]] || say "no fingerprint.betterlife.so in $IMAGE: hal can't run"
  [[ -f $IMAGE/vendor/firmware_mnt/image/btlap64.mdt ]] || say "no btlap64 trusted app in $IMAGE/vendor/firmware_mnt/image: hal can't load it"
  t=$(find "$IMAGE" \( -type b -o -type c \) -print -quit 2>/dev/null)
  [[ -z $t ]] || { say "$IMAGE holds a device node ($t): refusing"; ok=0; }
  stub_ok librpmb.so || ok=0
  stub_ok libssd.so || ok=0
  if [[ -f $HALHOST ]]; then say "HAL host: $HALHOST"; else say "no $HALHOST: hal can't run"; fi
  if [[ -f $BRIDGE ]]; then say "bridge: $BRIDGE"; else say "no $BRIDGE: bridge can't run"; fi
  if [[ -f $SHIM ]]; then say "shim: $SHIM (preloaded)"
  else say "no shim in $BIN: not preloaded (properties unset, logs through logdw)"; fi
  for n in "${!NODES[@]}"; do
    if id=$(node_id "$HDEV/${NODES[$n]}"); then
      say "node /dev/$n <- host $HDEV/${NODES[$n]} (c $id)"
    elif [[ $OPT_NODES == *" $n "* ]]; then
      say "no $HDEV/${NODES[$n]} (modprobe betterlife-fp): hal can't run"
    else
      say "no character device $HDEV/${NODES[$n]}"; ok=0
    fi
  done
  [[ -d $SYSFP ]] || say "no $SYSFP (the betterlife-fp driver)"
  say "state: $STATE (/data, /mnt/vendor/persist, /persist inside; no partition)"
  if [[ -n $RPMB_HOST ]]; then
    say "RPMB: the UFS RPMB well-known LU $RPMB_SYS (type 30), node $HDEV/$RPMB_HOST (c $RPMB_ID) -> /dev/$RPMB_NODE (root's, 0600; qseecomd only)"
    say "RPMB: $RPMB_FPT frames per transfer, $RPMB_SECTORS sectors of 512 bytes"
  else
    say "RPMB: $RPMB_WHY: refusing"; ok=0
  fi
  rpmb_writes_say
  say "RPMB pass-through log: $STATE$RPMB_LOG ($RPMB_LOG inside)"
  if [[ -e $STATE$RPMB_DIR || -L $STATE$RPMB_DIR ]]; then rpmb_dir_ok || ok=0
  else say "  not there yet (a start makes its directory root's, 0700)"; fi
  ((ok)) || { say "preconditions NOT met"; return 1; }
  say "preconditions met"
}

rpmb_writes_say() {
  if ((RPMB_WRITES)); then
    say "RPMB writes: ENABLED (the listener forwards TrustZone's authenticated writes to the real RPMB)"
  else
    say "RPMB writes: refused by the listener"
  fi
}

# The chroot as built, inside the namespace: refuses on any deviation.
audit() {
  local ok=1 e t p name id want mi mp fs src majmin
  say "audit: /dev in the chroot"
  while IFS= read -r e; do
    t=${e%% *} p=${e#* }
    case $t:$p in
      d:dma_heap|d:socket|d:__omamobile_props__) continue ;;
      s:socket/logdw|f:__omamobile_props__/*) continue ;;
      # the bridge's socket directory (its contents: audit_sockdir)
      d:socket/omamobile-fp) [[ $MODE == audit || $MODE == bridge ]] && continue ;;
      s:socket/omamobile-fp/bridge.sock) [[ $MODE == bridge ]] && continue ;;
    esac
    name=$p
    if [[ -n ${NODES[$name]+x} ]] && { [[ $t == c ]] || [[ -n $TROOT && $t == f ]]; }; then
      id=$(node_id "$ROOT/dev/$name") || { say "  /dev/$name: unreadable node"; ok=0; continue; }
      want=$(node_id "$HDEV/${NODES[$name]}") || want=none
      if [[ $name == "$RPMB_NODE" && $(stat -c '%u:%g %a' "$ROOT/dev/$name") != "0:0 600" ]]; then
        say "  /dev/$name is $(stat -c '%u:%g %a' "$ROOT/dev/$name"), want 0:0 600: REFUSED"; ok=0
      elif [[ $id == "$want" ]]; then
        say "  c $id $(stat -c '%U:%G %a' "$ROOT/dev/$name") /dev/$name (= host ${NODES[$name]})"
      else
        say "  /dev/$name is $id, host ${NODES[$name]} is $want: REFUSED"; ok=0
      fi
    else
      say "  /dev/$p (type $t): not in the allowlist: REFUSED"; ok=0
    fi
  done < <(find "$ROOT/dev" -mindepth 1 -printf '%y %P\n' | sort)
  t=$(find "$ROOT" -path "$ROOT/proc" -prune -o -path "$ROOT/dev" -prune -o \( -type b -o -type c \) -print 2>/dev/null)
  [[ -z $t ]] || { say "device nodes outside /dev: $t: REFUSED"; ok=0; }
  if [[ -z $TROOT ]]; then
    t=$(find "$ROOT/dev" -type b -print -quit)
    [[ -z $t ]] || { say "block device $t: REFUSED"; ok=0; }
  fi

  say "audit: mounts in the chroot (/proc/self/mountinfo)"
  local -A allowed_dev=()
  for p in "$IMAGE" "$BIN" "$STATE"; do
    majmin=$(findmnt -n -o MAJ:MIN -T "$p" | tr -d " ")
    [[ -n $majmin ]] && allowed_dev[$majmin]=1
  done
  # the socket directory's file system and its path in there (mountinfo's
  # root field of a bind of it)
  local sock_majmin=none sock_root=none sock_seen=0 target fsroot
  if [[ -d $SOCKDIR ]]; then
    sock_majmin=$(findmnt -n -o MAJ:MIN -T "$SOCKDIR" | tr -d " ")
    target=$(findmnt -n -o TARGET -T "$SOCKDIR")
    fsroot=$(findmnt -n -o FSROOT -T "$SOCKDIR")
    sock_root=${fsroot%/}${SOCKDIR#"${target%/}"}
  fi
  while read -r mi; do
    majmin=$(cut -d' ' -f3 <<<"$mi")
    mp=$(cut -d' ' -f5 <<<"$mi")
    read -r fs src _ <<<"${mi##* - }"
    [[ $mp == "$ROOT" || $mp == "$ROOT"/* ]] || continue
    p=${mp#"$ROOT"}; p=${p:-/}
    case $p in
      # ours: tmpfs (by the names setup gives them) and the namespace's proc
      /) want=tmpfs:omamobile-fp-ingot ;;
      /tmp) want=tmpfs:tmp ;;
      /dev) want=tmpfs:dev ;;
      /dev/__omamobile_props__) want=tmpfs:props ;;
      /sys) want=tmpfs:sys ;;
      /proc) want=proc:proc ;;
      # binds: only from the file systems of --image, --bin and --state
      /system|/vendor|/apex|/vendor/lib64/librpmb.so|/vendor/lib64/libssd.so|/data|/mnt/vendor/persist|/persist|/omamobile/omamobile-fp-halhost|/omamobile/omamobile-fp-bridge-ingot|/omamobile/omamobile-fp-shim.so) want=bind ;;
      # the one host directory: exactly $SOCKDIR, whatever its file system
      "$CSOCKDIR")
        if [[ $MODE == audit || $MODE == bridge ]] && [[ $majmin == "$sock_majmin" && $(cut -d' ' -f4 <<<"$mi") == "$sock_root" ]]; then
          say "  $p: bind of the host's $SOCKDIR ($fs $majmin, root $sock_root)"
          ((++sock_seen))
        else
          say "  $p: $fs $majmin root $(cut -d' ' -f4 <<<"$mi") is not the host's $SOCKDIR ($sock_majmin root $sock_root): REFUSED"; ok=0
        fi
        continue ;;
      *) say "  $p: unexpected mount point: REFUSED"; ok=0; continue ;;
    esac
    if [[ $want == bind ]]; then
      if [[ -n ${allowed_dev[$majmin]:-} ]]; then
        say "  $p: bind from $src ($fs $majmin, the file system of --image/--bin/--state)"
      else
        say "  $p: $fs $src ($majmin) is not the file system of --image, --bin or --state: REFUSED"; ok=0
      fi
    elif [[ $fs:$src == "$want" ]]; then
      say "  $p: $fs"
    else
      say "  $p: $fs $src, want ${want/:/ }: REFUSED"; ok=0
    fi
  done < /proc/self/mountinfo
  if [[ $MODE == audit || $MODE == bridge ]]; then
    ((sock_seen == 1)) || { say "  $CSOCKDIR: $sock_seen binds of the host's $SOCKDIR, want 1: REFUSED"; ok=0; }
    audit_sockdir empty || ok=0
  fi

  say "audit: the stubs as the chroot sees them"
  for name in librpmb.so libssd.so; do
    t=$(sha "$ROOT/vendor/lib64/$name")
    if [[ $t == "$(sha "$BIN/$name")" ]]; then
      say "  /vendor/lib64/$name = $BIN/$name (sha256 ${t:0:16})"
    else
      say "  /vendor/lib64/$name (sha256 ${t:0:16}) is not the stub: REFUSED"; ok=0
    fi
    [[ ! -f $IMAGE/vendor/lib64/$name || $t != "$(sha "$IMAGE/vendor/lib64/$name")" ]] ||
      { say "  /vendor/lib64/$name is the vendor's: REFUSED"; ok=0; }
  done
  say "audit: the RPMB pass-through's directory"
  rpmb_dir_ok || ok=0
  [[ -f $ROOT/mnt/vendor/persist/.omamobile-fp-ingot ]] ||
    { say "  /mnt/vendor/persist is not the state directory's persist: REFUSED"; ok=0; }
  [[ -f $ROOT/persist/.omamobile-fp-ingot ]] ||
    { say "  /persist is not the state directory's persist: REFUSED"; ok=0; }
  # the kernel shows a chrooted process mount points relative to its root:
  # $ROOT/mnt/vendor/persist here is /mnt/vendor/persist in its /proc/mounts
  if awk -v m="$ROOT/mnt/vendor/persist" '$2 == m {f = 1} END {exit !f}' /proc/self/mounts; then
    say "  /mnt/vendor/persist and /persist: the state directory's persist (in the chroot's /proc/mounts)"
  else
    say "  /mnt/vendor/persist missing from /proc/mounts (libdrmfs waits for it)"; ok=0
  fi
  ((ok)) || die "audit failed: nothing started"
  say "audit passed"
}

# The socket directory: empty (before the bridge), or exactly the bridge's
# socket, root's, 0600, in a root-only directory (after). $1 empty|socket
audit_sockdir() {
  local ok=1 e want
  [[ $1 == empty ]] && want="" || want="s bridge.sock"
  e=$(find "$SOCKDIR" -mindepth 1 -printf '%y %P\n' | sort | tr '\n' ' ')
  e=${e% }
  if [[ $e != "$want" ]]; then
    say "  $SOCKDIR holds '${e}', want '${want}': REFUSED"; ok=0
  fi
  if [[ $1 == socket ]]; then
    e=$(stat -c '%u:%g %a' -- "$SOCKDIR")
    [[ $e == "0:0 700" ]] || { say "  $SOCKDIR is $e, want 0:0 700: REFUSED"; ok=0; }
    if [[ -S $SOCK ]]; then
      e=$(stat -c '%u:%g %a' -- "$SOCK")
      [[ $e == "0:0 600" ]] || { say "  $SOCK is $e, want 0:0 600: REFUSED"; ok=0; }
    fi
  fi
  ((ok)) && say "  $SOCKDIR: ${want:-empty}${want:+ (root, 0600; directory root, 0700)}"
  ((ok))
}

# The RPMB pass-through's directory on the host: root's, 0700, reached
# through no link, holding only regular files, root's, 0600. uid 1000 owns
# data/vendor, so it could rename the directory away and leave its own (or a
# link to anywhere) in its place: refused, never repaired.
rpmb_dir_ok() {
  local d=$STATE$RPMB_DIR ok=1 e real
  if [[ -L $d || ! -d $d ]]; then say "  $d is not a directory (or is a link): REFUSED"; return 1; fi
  real=$(realpath -e -- "$STATE")$RPMB_DIR
  e=$(realpath -e -- "$d")
  [[ $e == "$real" ]] || { say "  $d resolves to $e, not $real: REFUSED"; ok=0; }
  e=$(stat -c '%u:%g %a' -- "$d")
  [[ $e == "0:0 700" ]] || { say "  $d is $e, want 0:0 700: REFUSED"; ok=0; }
  # "TYPE UID:GID MODE SIZE NAME" of everything in it (never its contents)
  while IFS= read -r -d '' e; do
    if [[ $e =~ ^f\ 0:0\ 600\ ([0-9]+)\ ([^/]+)$ ]]; then
      say "  $d/${BASH_REMATCH[2]}: root's, 0600, ${BASH_REMATCH[1]} bytes"
    else
      say "  $d holds '$e' (want only regular files, 0:0 600): REFUSED"; ok=0
    fi
  done < <(find "$d" -mindepth 1 -printf '%y %U:%G %m %s %P\0')
  ((ok)) && say "  $d: root's, 0700, only regular files (root's, 0600)"
  ((ok))
}

# $1 is $2, or under it, for one of $2...
under() {
  local f=$1 p; shift
  for p; do [[ $f == "$p" || $f == "$p"/* ]] && return 0; done
  return 1
}

# What every process of the namespace holds open (SAFETY: the fd audit),
# from the namespace's own /proc ($ROOT/proc: its pids, valid from here).
# Android processes are the ones whose root is the chroot; the others are
# this runner's own (the log reader, the log pipes, this shell), which may
# also hold $RUN, this script and whatever they inherited as fds 0-2 (a
# terminal, the journal, a log file). Stops the stage on any deviation.
# $1: when.
audit_fds() {
  local ok=1 d p fd ty mm link comm android n devs rpmb bad id self cdev
  local -a mine
  local -A allowed=() types=()
  for n in "${!NODES[@]}"; do
    id=$(node_id "$HDEV/${NODES[$n]}") && allowed[$id]=/dev/$n
  done
  self=$(realpath -e -- "$0")
  mine=("$ROOT" "$IMAGE" "$BIN" "$STATE")
  [[ -n $TROOT ]] && mine+=("$TROOT")
  say "audit: open files of every process in the namespace ($1)"
  for d in "$ROOT"/proc/[0-9]*; do
    p=${d##*/}
    { read -r comm < "$d/comm"; } 2>/dev/null || continue     # gone
    android=0
    [[ $(readlink "$d/root" 2>/dev/null) == "$ROOT" ]] && android=1
    if ! [[ -r $d/fd && -x $d/fd ]]; then
      [[ -d $d ]] && { say "  $comm ($p): its open files are unreadable: REFUSED"; ok=0; }
      continue
    fi
    types=()
    while IFS= read -r -d '' fd && IFS= read -r -d '' ty && IFS= read -r -d '' mm; do
      types[${fd##*/}]="$ty|$mm"
    done < <(stat -L --printf '%n\0%F\0%t:%T\0' -- "$d"/fd/* 2>/dev/null)
    n=0 devs='' rpmb=''
    while IFS= read -r -d '' fd && IFS= read -r -d '' link; do
      [[ -n ${types[$fd]:-} ]] || continue                    # closed meanwhile
      ((++n))
      ty=${types[$fd]%|*} mm=${types[$fd]##*|} bad='' cdev=''
      [[ $ty == "character special file" ]] && cdev=$((16#${mm%:*})):$((16#${mm#*:}))
      # a test's device node: a file in the chroot's /dev reading "c MAJ:MIN"
      if [[ -n $TROOT && $ty == regular* && $link == "$ROOT/dev/"* ]]; then
        cdev=$(node_id "$link") || cdev=''
      fi
      if [[ -n $cdev ]]; then
        if [[ $cdev == "${RPMB_ID:-none}" ]] && ! { ((android)) && [[ $comm == qseecomd ]]; }; then
          bad="character device $cdev $link, the RPMB node: only qseecomd may hold it"
        elif [[ -n ${allowed[$cdev]:-} ]]; then devs+=" ${allowed[$cdev]}($cdev)"
        elif ((!android && fd <= 2)); then devs+=" $link($cdev, inherited fd $fd)"
        else bad="character device $cdev $link, not an allowlisted node"; fi
      elif [[ $ty == "block special file" ]]; then
        bad="block device $((16#${mm%:*})):$((16#${mm#*:})) $link"
      else
        case $link in
          # no path: nothing outside reached through it
          socket:\[*\]|pipe:\[*\]|anon_inode:*|/dmabuf:*|/memfd:*) ;;
          "$ROOT$RPMB_DIR"/*|"$STATE$RPMB_DIR"/*)
            if [[ $ty == regular* && ( $link == "$ROOT$RPMB_LOG" || $link == "$STATE$RPMB_LOG" ) ]]; then
              rpmb+=" ${link##*/}"
              say "  $comm ($p) fd $fd: the RPMB pass-through's $link"
            else
              bad="$ty $link: in the RPMB pass-through's directory, not its passthrough.log"
            fi ;;
          *)
            under "$link" "${mine[@]}" && continue
            ((!android)) && { under "$link" "$RUN" "$self" || ((fd <= 2)); } && continue
            bad="$ty $link: outside the chroot, --image, --bin and the state directory" ;;
        esac
      fi
      [[ -z $bad ]] || { say "  $comm ($p) fd $fd: $bad: REFUSED"; ok=0; }
    done < <(find "$d/fd" -mindepth 1 -maxdepth 1 -printf '%f\0%l\0' 2>/dev/null)
    say "  $comm ($p$( ((android)) && echo ', in the chroot')): $n fds${devs:+; devices:$devs}${rpmb:+; RPMB log:$rpmb}"
  done
  ((ok)) || die "fd audit failed ($1): stopping"
  say "fd audit passed ($1)"
}

# The spawned process $1 has exec'd its program in the chroot (5 s at most;
# fails if it exited first).
execd() {
  local p=${PIDS[$1]} i c
  for ((i = 0; i < 50; i++)); do
    { read -r c < "$ROOT/proc/$p/comm"; } 2>/dev/null || return 1
    alive "$p" || return 1
    case $c in
      env|setsid|setpriv|chroot) ;;
      *) [[ $(readlink "$ROOT/proc/$p/root" 2>/dev/null) == "$ROOT" ]] && return 0 ;;
    esac
    sleep 0.1
  done
  return 1
}

# --- Building the chroot (inside the private namespace) -------------------------

bind() { # src dst [ro]
  local src=$1 dst=$2
  if [[ -d $src ]]; then mkdir -p "$dst"; else mkdir -p "$(dirname "$dst")"; [[ -e $dst ]] || : > "$dst"; fi
  mount --bind "$src" "$dst"
  [[ ${3:-} == ro ]] && mount -o remount,bind,ro "$dst"
  return 0
}

write_props() {
  local dir=$1 line k v
  [[ -f $IMAGE/vendor/build.prop ]] || return 0
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*# || $line != *=* ]] && continue
    k=${line%%=*} v=${line#*=}
    [[ $k =~ ^[A-Za-z0-9_.:@-]+$ ]] || continue
    printf '%s' "$v" > "$dir/$k"
  done < "$IMAGE/vendor/build.prop"
}

setup_state() {
  local d
  install -d -m 0700 "$STATE"
  for d in data data/vendor data/vendor/tzstorage data/misc data/misc/qsee data/vendor/blfp \
      data/vendor/blfp/pic persist persist/data data/vendor/omamobile-fp data/vendor_de \
      data/vendor_de/0 data/vendor_de/0/fpdata; do
    install -d -m 0770 "$STATE/$d"
    chown "$SYS_ID:$SYS_ID" "$STATE/$d"
  done
  chmod 0771 "$STATE/data" "$STATE/data/vendor" "$STATE/data/misc" "$STATE/data/vendor_de" \
    "$STATE/data/vendor_de/0"
  # the bridge's secret and gatekeeper handle: its user only
  chmod 0700 "$STATE/data/vendor/omamobile-fp"
  # the RPMB pass-through's: root's only (it opens its log as root, before
  # qseecomd drops to uid 1000). Never through a link: chown and chmod
  # would follow it (check refuses one before this runs; this is the
  # backstop).
  [[ ! -L $STATE$RPMB_DIR ]] || die "$STATE$RPMB_DIR is a link: refusing"
  install -d -m 0700 "$STATE$RPMB_DIR"
  chown 0:0 "$STATE$RPMB_DIR"
  chmod 0700 "$STATE$RPMB_DIR"
  rpmb_log_rotate
  # the audit finds this marker through both persist mount points
  : > "$STATE/persist/.omamobile-fp-ingot"
}

# The pass-through's log, before the listener opens it (O_APPEND, so a
# rotation while it runs would be lost): past RPMB_LOG_ROTATE_BYTES, .1 and
# .2 move up and the oldest goes. Only regular files, never through a link
# (rpmb_dir_ok refuses the directory otherwise; this is the backstop).
rpmb_log_rotate() {
  local f=$STATE$RPMB_LOG s
  [[ -f $f && ! -L $f ]] || return 0
  s=$(stat -c %s -- "$f") || return 0
  ((s > RPMB_LOG_ROTATE_BYTES)) || return 0
  say "rotating the RPMB pass-through's log ($s bytes): passthrough.log -> .1 -> .2"
  [[ -L $f.1 || -L $f.2 ]] && die "$f.1 or $f.2 is a link: refusing"
  rm -f -- "$f.2"
  [[ -f $f.1 ]] && mv -f -- "$f.1" "$f.2"
  mv -f -- "$f" "$f.1"
  return 0
}

setup() {
  local n
  mkdir -p "$ROOT"
  mount -t tmpfs -o mode=0755,nosuid omamobile-fp-ingot "$ROOT"
  for n in system vendor apex; do bind "$IMAGE/$n" "$ROOT/$n" ro; done
  # the stubs over the vendor's (files that exist in the read-only image)
  for n in librpmb.so libssd.so; do
    [[ -f $ROOT/vendor/lib64/$n ]] || die "no /vendor/lib64/$n to cover"
    mount --bind "$BIN/$n" "$ROOT/vendor/lib64/$n"
    mount -o remount,bind,ro "$ROOT/vendor/lib64/$n"
  done
  mkdir -p "$ROOT/proc" "$ROOT/sys" "$ROOT/dev" "$ROOT/data" "$ROOT/tmp" "$ROOT/mnt/vendor/persist" \
    "$ROOT/persist" "$ROOT/linkerconfig" "$ROOT/omamobile"
  ln -s /system/bin "$ROOT/bin"
  ln -s /system/etc "$ROOT/etc"
  mount -t tmpfs -o mode=1777,nosuid,nodev tmp "$ROOT/tmp"
  mount -t proc -o nosuid,nodev,noexec proc "$ROOT/proc"
  [[ -f $HALHOST ]] && bind "$HALHOST" "$ROOT/omamobile/omamobile-fp-halhost" ro
  [[ $MODE == bridge && -f $BRIDGE ]] && bind "$BRIDGE" "$ROOT/omamobile/omamobile-fp-bridge-ingot" ro
  [[ -f $SHIM ]] && bind "$SHIM" "$ROOT/omamobile/omamobile-fp-shim.so" ro

  # /dev: the allowlist, nothing else
  mount -t tmpfs -o mode=0755,nosuid,noexec dev "$ROOT/dev"
  for n in "${!NODES[@]}"; do
    make_node "$n" || [[ $OPT_NODES == *" $n "* ]] || die "can't make /dev/$n"
  done
  install -d -m 0755 "$ROOT/dev/socket"
  # the bridge's socket directory, fresh and root's (bridge_socket hands it
  # to the bridge and back)
  if [[ $MODE == audit || $MODE == bridge ]]; then
    install -d -m 0755 "$(dirname "$SOCKDIR")"
    rm -rf -- "$SOCKDIR"
    install -d -m 0700 "$SOCKDIR"
    chown 0:0 "$SOCKDIR"
    bind "$SOCKDIR" "$ROOT$CSOCKDIR"
  fi
  mkdir -p "$ROOT/dev/__omamobile_props__"
  mount -t tmpfs -o mode=0775,nosuid,nodev,noexec props "$ROOT/dev/__omamobile_props__"
  chown "$SYS_ID:$SYS_ID" "$ROOT/dev/__omamobile_props__"
  write_props "$ROOT/dev/__omamobile_props__"
  # the log reader binds its socket before /dev goes read-only
  start_logd
  mount -o remount,ro,bind "$ROOT/dev"

  # /sys: only libqisl's two clock uevent files, copied
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec sys "$ROOT/sys"
  for n in bus/clockevents/devices/clockevent0/uevent bus/clocksource/devices/clocksource0/uevent; do
    mkdir -p "$ROOT/sys/$(dirname "$n")"
    cat "$HSYS/$n" > "$ROOT/sys/$n" 2>/dev/null || true
  done
  mount -o remount,ro,bind "$ROOT/sys"

  setup_state
  bind "$STATE/data" "$ROOT/data"
  bind "$STATE/persist" "$ROOT/mnt/vendor/persist"
  bind "$STATE/persist" "$ROOT/persist"
  # tools/ingot-fp-stage-test: one fault the audit must refuse
  [[ -n $TROOT ]] && case ${OMAMOBILE_FP_TEST_INJECT:-} in
    dev-extra) mount -o remount,rw,bind "$ROOT/dev"; echo 'c 8:0' > "$ROOT/dev/sda" ;;
    dev-wrong) mount -o remount,rw,bind "$ROOT/dev"; echo 'c 1:5' > "$ROOT/dev/qseecom" ;;
    mount-extra) mkdir -p "$ROOT/mnt/x"; mount -t tmpfs x "$ROOT/mnt/x" ;;
    stub-vendor) mount --bind "$IMAGE/vendor/lib64/librpmb.so" "$ROOT/vendor/lib64/librpmb.so" ;;
    sock-extra) : > "$SOCKDIR/planted" ;;
    sock-wrong) mount --bind "$STATE/persist/data" "$ROOT$CSOCKDIR" ;;
    sock-twice) mkdir -p "$ROOT/tmp/s"; mount --bind "$SOCKDIR" "$ROOT/tmp/s" ;;
    rpmb-wrong) chown "$SYS_ID:$SYS_ID" "$STATE$RPMB_DIR"; chmod 0770 "$STATE$RPMB_DIR" ;;
    rpmb-link) ln -s /etc/passwd "$STATE$RPMB_LOG" ;;
    rpmb-mode) mount -o remount,rw,bind "$ROOT/dev"; chmod 0660 "$ROOT/dev/$RPMB_NODE" ;;
  esac
  return 0
}

# --- Processes -----------------------------------------------------------------

LOGD_PY='
import os, signal, socket, struct, sys
path, proc = sys.argv[1], sys.argv[2]
signal.signal(signal.SIGINT, signal.SIG_IGN)
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
s.bind(path)
os.chmod(path, 0o666)
open(path + ".ready", "w").close()
P = "??VDIWEFS"
def comm(pid):
    try:
        with open("%s/%d/comm" % (proc, pid)) as f:
            return f.read().strip()
    except OSError:
        return "pid %d" % pid
while True:
    data, anc, _, _ = s.recvmsg(65536, socket.CMSG_SPACE(12))
    pid = 0
    for lvl, typ, d in anc:
        if lvl == socket.SOL_SOCKET and typ == socket.SCM_CREDENTIALS:
            pid = struct.unpack("i", d[:4])[0]
    if len(data) < 12:
        continue
    lid, tid = data[0], struct.unpack_from("<H", data, 1)[0]
    body = data[11:]
    name = comm(pid)
    if lid in (2, 5, 6):
        print("[%s] %d/%d binary log %d (%d bytes)" % (name, pid, tid, lid, len(body)), flush=True)
        continue
    prio = P[body[0]] if body[0] < len(P) else "?"
    tag, _, msg = body[1:].partition(b"\0")
    msg = msg.rstrip(b"\0").decode("utf-8", "replace")
    tag = tag.decode("utf-8", "replace")
    for line in msg.splitlines() or [""]:
        print("[%s] %d/%d %s %s: %s" % (name, pid, tid, prio, tag, line), flush=True)
'

declare -A PIDS=()

# A terminal ^C must not kill the log pipes before the processes are stopped.
logpipe() { trap '' INT; sed -u "s/^/[$1] /" | tee -a "$LOG"; }

start_logd() {
  [[ -x $PYTHON_BIN ]] || { say "no python3: no log reader"; return 0; }
  # outside the chroot: it reads the namespace's /proc for process names
  "$PYTHON_BIN" -I -c "$LOGD_PY" "$ROOT/dev/socket/logdw" "$ROOT/proc" > >(trap '' INT; tee -a "$LOG") 2>&1 &
  PIDS[logd]=$!
  local i
  for ((i = 0; i < 50; i++)); do
    [[ -e $ROOT/dev/socket/logdw.ready ]] && { rm -f "$ROOT/dev/socket/logdw.ready"; return 0; }
    sleep 0.1
  done
  say "the log reader did not start"
}

# Android environment for one process; $1 root|system|qseecomd (root,
# keeping sys_rawio), rest: command.
android_cmd() {
  local who=$1; shift
  local user=(--userspec=0:0 --groups=0) caps=$DROP_CAPS
  [[ $who == system ]] && user=(--userspec="$SYS_ID:$SYS_ID" --groups="$SYS_ID")
  [[ $who == qseecomd ]] && caps=$DROP_CAPS_QSEECOMD
  # a test's user namespace may not set groups (and maps only root)
  [[ -n $TROOT ]] && user=()
  local env=(PATH=/system/bin:/vendor/bin LD_LIBRARY_PATH=/vendor/lib64:/vendor/lib64/hw:/system/lib64
             ANDROID_ROOT=/system ANDROID_DATA=/data OMAMOBILE_FP_PROPS=/dev/__omamobile_props__
             OMAMOBILE_RPMB_DEV="/dev/$RPMB_NODE" OMAMOBILE_RPMB_LOG="$RPMB_LOG"
             OMAMOBILE_RPMB_WRITES="$RPMB_WRITES" OMAMOBILE_RPMB_FPT="$RPMB_FPT"
             OMAMOBILE_RPMB_SECTORS="$RPMB_SECTORS"
             OMAMOBILE_FP_LOGLEVEL="${OMAMOBILE_FP_LOGLEVEL:-3}")
  [[ -f $ROOT/omamobile/omamobile-fp-shim.so ]] && env+=(LD_PRELOAD=/omamobile/omamobile-fp-shim.so)
  CMDLINE=(env -i "${env[@]}" "$SETSID_BIN" "$SETPRIV_BIN" --bounding-set "$caps" --
           "$CHROOT_BIN" "${user[@]}" "$ROOT" "$@")
}

spawn() { # name root|system command...
  local name=$1; shift
  say "starting $name: ${*:2}"
  android_cmd "$@"
  # not the runner's lock (fd 9): nothing of the host's beyond the chroot
  # (stdin is /dev/null: a background job's without job control)
  if [[ -n $TROOT && $name == qseecomd && ${OMAMOBILE_FP_TEST_INJECT:-} == fd-* ]]; then
    # tools/ingot-fp-stage-test: an fd the fd audit must refuse
    local leak=/etc/passwd
    [[ $OMAMOBILE_FP_TEST_INJECT == fd-char ]] && leak=/dev/ptmx
    "${CMDLINE[@]}" 9>&- 7< "$leak" > >(logpipe "$name") 2>&1 &
  else
    "${CMDLINE[@]}" 9>&- > >(logpipe "$name") 2>&1 &
  fi
  PIDS[$name]=$!
}

alive() {
  local st
  st=$(sed 's/^.*) //' "$ROOT/proc/$1/stat" 2>/dev/null) || return 1
  [[ -n $st && ${st%% *} != Z ]]
}

stop_one() { # name tenths
  local p=${PIDS[$1]:-} i
  [[ -n $p ]] || return 0
  kill -TERM "$p" 2>/dev/null || true
  for ((i = 0; i < $2; i++)); do alive "$p" || return 0; sleep 0.1; done
  say "$1 still running after $(($2 / 10)) s: KILL"
  kill -KILL "$p" 2>/dev/null || true
}

DMESG0=0
kernel_report() {
  local f v
  for f in chipid version irq_count; do
    v=$(cat "$SYSFP/$f" 2>/dev/null) || v="(unreadable)"
    say "$SYSFP/$f: $v"
  done
  say "kernel log since the start (qseecom, blfp, betterlife, fingerprint):"
  { dmesg 2>/dev/null || true; } | tail -n +"$((DMESG0 + 1))" |
    grep -iE 'qseecom|qsee|blfp|betterlife|btl|fingerprint|scm|tz' | sed 's/^/  /' >&2 || true
  v=$(cat "$SYSFP/chipid" 2>/dev/null || true)
  if [[ ${v,,} == *5f83* ]]; then say "S3 PASS: chipid $v"; else say "S3 FAIL: chipid '${v}' (want 5f83)"; fi
}

STOPPING=
stop() {
  local code=${1:-0}
  [[ -n $STOPPING ]] && exit "$code"
  STOPPING=1
  trap '' TERM INT
  say "stopping: the HAL host or the bridge first, then qseecomd"
  stop_one halhost 50
  stop_one bridge 50
  # nothing listens any more: fprintd's next connect fails at once
  [[ $MODE == bridge || $MODE == audit ]] && rm -rf -- "$SOCKDIR"
  [[ $MODE == hal && -n ${PIDS[halhost]:-} ]] && kernel_report
  stop_one run 30
  stop_one qseecomd 50
  stop_one logd 10
  rm -f "$NSPID"
  # as the namespace's PID 1, exiting ends whatever is left
  exit "$code"
}

# Listeners registered: the shim's property, else qseecomd's "Started
# (Listener ID = N)" lines, with no new one for 3 s.
wait_listeners() {
  local i n last=-1 same=0 p=$ROOT/dev/__omamobile_props__/vendor.sys.listeners.registered
  if [[ ! -x $PYTHON_BIN && ! -f $ROOT/omamobile/omamobile-fp-shim.so ]]; then
    say "no log reader and no shim: can't see the listeners; waiting 15 s"
    sleep 15
    alive "${PIDS[qseecomd]}" || die "qseecomd exited"
    return 0
  fi
  for ((i = 0; i < 900; i++)); do
    alive "${PIDS[qseecomd]}" || die "qseecomd exited before its listeners were registered"
    [[ -f $p && $(cat "$p") == true ]] && { say "listeners registered (vendor.sys.listeners.registered)"; return 0; }
    n=$(grep -c 'Started (Listener ID' "$LOG" 2>/dev/null || true)
    if ((n > 0 && n == last)); then
      ((++same >= 30)) && { say "listeners registered: $n started, none new for 3 s"; return 0; }
    else
      same=0 last=$n
    fi
    sleep 0.1
  done
  die "qseecomd's listeners not registered in 90 s"
}

# Wait for the bridge's socket, then make it and its directory root's: the
# listening socket keeps working, and uid 1000 can no longer connect to it,
# replace it or add anything next to it.
bridge_socket() {
  local i
  for ((i = 0; i < 1200; i++)); do
    [[ -S $SOCK ]] && break
    alive "${PIDS[bridge]}" || die "the bridge exited before its socket appeared"
    alive "${PIDS[qseecomd]}" || die "qseecomd exited before the bridge's socket appeared"
    sleep 0.1
  done
  [[ -S $SOCK ]] || die "no socket $SOCK after 120 s"
  # the bridge chmods and listens right after its bind: let it finish (its
  # "ready on" line, or 2 s) before the socket is no longer its own
  for ((i = 0; i < 20; i++)); do
    grep -q 'ready on' "$LOG" 2>/dev/null && break
    sleep 0.1
  done
  chown 0:0 "$SOCK" "$SOCKDIR"
  chmod 0600 "$SOCK"
  chmod 0700 "$SOCKDIR"
  say "audit: the bridge's socket"
  audit_sockdir socket || die "the socket directory is not as it should be: stopping"
}

# The namespace's PID 1.
inner() {
  [[ $$ == 1 ]] || die "the inner start runs only as a new PID namespace's PID 1"
  # the host's PID of this shell (a builtin read: /proc/self is this shell)
  local k v1 _rest hostpid=
  while read -r k v1 _rest; do [[ $k == NSpid: ]] && hostpid=$v1; done < /proc/self/status
  echo "$hostpid" > "$NSPID"
  trap 'stop 0' TERM INT
  trap 'stop $?' EXIT
  : > "$LOG"
  SAYLOG=1
  check
  setup
  audit
  [[ $MODE == audit ]] && { STOPPING=1; exit 0; }
  DMESG0=$({ dmesg 2>/dev/null || true; } | wc -l)
  if [[ $MODE == run ]]; then
    local who=root; ((AS_SYSTEM)) && who=system
    spawn run "$who" "${CMD[@]}"
    wait "${PIDS[run]}" || true
    stop 0
  fi
  rpmb_writes_say
  spawn qseecomd qseecomd /vendor/bin/qseecomd
  if [[ $MODE == hal ]]; then
    wait_listeners
    audit_fds "qseecomd's listeners up"
    [[ -c $ROOT/dev/blfp || ( -n $TROOT && -f $ROOT/dev/blfp ) ]] || die "no /dev/blfp in the chroot"
    local who=system; ((HAL_ROOT)) && who=root
    spawn halhost "$who" /omamobile/omamobile-fp-halhost ${SECONDS_ARG:+--seconds "$SECONDS_ARG"} open
    if execd halhost; then audit_fds "the HAL host started"
    else say "the HAL host exited before its fds could be audited"; fi
    say "stage hal running (^C stops)"
    wait -n "${PIDS[halhost]}" "${PIDS[qseecomd]}" || true
    [[ -n $STOPPING ]] || say "$(alive "${PIDS[qseecomd]}" && echo "the HAL host" || echo qseecomd) exited"
    stop 0
  fi
  if [[ $MODE == bridge ]]; then
    wait_listeners
    audit_fds "qseecomd's listeners up"
    [[ -c $ROOT/dev/blfp || ( -n $TROOT && -f $ROOT/dev/blfp ) ]] || die "no /dev/blfp in the chroot"
    # the bridge binds its socket as uid 1000: the directory is its until then
    chown "$SYS_ID:$SYS_ID" "$SOCKDIR"
    spawn bridge system /omamobile/omamobile-fp-bridge-ingot --socket "$CSOCKDIR/bridge.sock" \
      --state "$BRIDGE_STATE" --data-path /data/vendor_de/0/fpdata \
      ${ENROLL_TIMEOUT:+--enroll-timeout "$ENROLL_TIMEOUT"}
    bridge_socket
    audit_fds "the bridge's socket up"
    say "stage bridge running: $SOCK (^C or ingot-fp-stage stop stops)"
    wait -n "${PIDS[bridge]}" "${PIDS[qseecomd]}" || true
    [[ -n $STOPPING ]] || say "$(alive "${PIDS[qseecomd]}" && echo "the bridge" || echo qseecomd) exited"
    stop 1
  fi
  say "stage listeners running (^C stops)"
  wait -n "${PIDS[qseecomd]}" || true
  [[ -n $STOPPING ]] || say "qseecomd exited"
  stop 1
}

# Into a running stage's namespaces (run, when one is up).
run_attached() {
  local p who=root
  p=$(cat "$NSPID" 2>/dev/null) || return 1
  [[ $p =~ ^[0-9]+$ ]] && kill -0 "$p" 2>/dev/null || return 1
  ((AS_SYSTEM)) && who=system
  android_cmd "$who" "${CMD[@]}"
  say "running in the stage's namespace (PID $p)"
  exec nsenter --target "$p" --mount --pid "${CMDLINE[@]}"
}

# The socket directory is the Pixel runner's too (omamobile-fp-chroot, the
# same fprintd drop-in): never take it from a running Pixel stack.
sock_free() {
  local p
  p=$(cat "$TROOT/run/omamobile-fp/ns.pid" 2>/dev/null || true)
  if [[ $p =~ ^[0-9]+$ ]] && kill -0 "$p" 2>/dev/null; then
    die "omamobile-fp-chroot's stack runs (PID $p) and owns $SOCKDIR: not starting"
  fi
  return 0
}

# The modules the nodes come from; nothing loads them at boot. Before check,
# which refuses a missing /dev/qseecom.
load_modules() {
  local mp=modprobe
  if [[ -n $TROOT ]]; then
    mp=${OMAMOBILE_FP_TEST_MODPROBE:-}
    [[ -n $mp ]] || return 0
  fi
  if ! [[ -c $HDEV/qseecom || ( -n $TROOT && -f $HDEV/qseecom ) ]]; then
    say "no $HDEV/qseecom: modprobe qcom_qseecom_user"
    "$mp" qcom_qseecom_user || say "modprobe qcom_qseecom_user failed"
  fi
  if [[ $MODE == hal || $MODE == bridge ]] && ! [[ -c $HDEV/blfp || ( -n $TROOT && -f $HDEV/blfp ) ]]; then
    say "no $HDEV/blfp: modprobe betterlife-fp"
    "$mp" betterlife-fp || say "modprobe betterlife-fp failed"
  fi
  [[ -z $TROOT ]] && command -v udevadm >/dev/null && { udevadm settle -t 5 || true; }
  return 0
}

outer() {
  load_modules
  check
  [[ $MODE != bridge && $MODE != audit ]] || sock_free
  install -d -m 0700 "$RUN"
  exec 9> "$RUN/lock"
  flock -n 9 || die "another listeners/hal/bridge stage is running (run attaches to it; ingot-fp-stage stop stops it)"
  local fwd=()
  unshare --help 2>/dev/null | grep -q -- '--forward-signals' && fwd=(--forward-signals)
  local args=(--image "$IMAGE" --bin "$BIN" --state "$STATE")
  [[ -n $SECONDS_ARG ]] && args+=(--seconds "$SECONDS_ARG")
  [[ -n $ENROLL_TIMEOUT ]] && args+=(--enroll-timeout "$ENROLL_TIMEOUT")
  ((HAL_ROOT)) && args+=(--hal-root)
  ((AS_SYSTEM)) && args+=(--as-system)
  ((RPMB_WRITES)) && args+=(--rpmb-writes)
  ((${#CMD[@]})) && args+=(-- "${CMD[@]}")
  exec unshare --mount --propagation private --pid --fork --kill-child "${fwd[@]}" \
    env OMAMOBILE_FP_INGOT_INNER=1 "$0" "$MODE" "${args[@]}"
}

case $MODE in
  check) check ;;
  audit|listeners|hal|bridge|run)
    [[ $MODE != run ]] || ((${#CMD[@]})) || die "usage: ingot-fp-stage run --image DIR --bin DIR -- CMD..."
    [[ $MODE != hal || -f $HALHOST ]] || die "no $HALHOST"
    [[ $MODE != bridge || -f $BRIDGE ]] || die "no $BRIDGE"
    if [[ -n ${OMAMOBILE_FP_INGOT_INNER:-} ]]; then
      inner
    else
      [[ $MODE == run ]] && run_attached
      outer
    fi ;;
  *) usage ;;
esac
