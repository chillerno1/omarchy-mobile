#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-fingerprint into DESTDIR. Google's Android
# files are not part of the package: tools/extract-fingerprint-vendor makes
# them from the user's own factory image (/usr/lib/omamobile-fp/root,
# MANIFEST, SOURCE), and tools/ingot-fp-provision the Solana Saga's from
# its own slot B (/usr/lib/omamobile-fp-ingot/root). The bionic programs
# are built on the computer first (the Pixels', then the Saga's):
#   make -C fingerprint CLANG=... BIONIC=... CHROOT=out/fingerprint-vendor/root \
#     OUT=$PWD/packages/omamobile-fingerprint/prebuilt
#   make -C fingerprint/ingot NDK=... CHROOT=out/fingerprint-vendor-ingot/root \
#     OUT=$PWD/packages/omamobile-fingerprint/prebuilt/ingot
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
l=$d/usr/lib/omamobile-fp
install -Dm755 lib/omamobile-fp-chroot "$l/omamobile-fp-chroot"
install -Dm755 lib/omamobile-tipc-probe "$l/omamobile-tipc-probe"
install -Dm755 lib/omamobile-fp-ctl "$l/omamobile-fp-ctl"
install -Dm644 lib/props.conf "$l/props.conf"
install -Dm644 lib/props-cheetah.conf "$l/props-cheetah.conf"
install -Dm644 lib/props-tegu.conf "$l/props-tegu.conf"
install -Dm644 lib/props-panther.conf "$l/props-panther.conf"
install -Dm644 prebuilt/omamobile-fp-shim.so "$l/omamobile-fp-shim.so"
install -Dm755 prebuilt/omamobile-fp-bridge "$l/omamobile-fp-bridge"
install -Dm644 vendor/systemd/system/omamobile-fp.service "$d/usr/lib/systemd/system/omamobile-fp.service"
# Enabled by a vendor wants link: fingerprint starts by default, and only
# with this runner (its copies, TDP guard and one proxy per boot). The unit is
# inert until tools/phone-provision has pushed Google's files.
install -d "$d/usr/lib/systemd/system/multi-user.target.wants"
ln -sfn ../omamobile-fp.service "$d/usr/lib/systemd/system/multi-user.target.wants/omamobile-fp.service"
# The Solana Saga (ingot): its runner, our bionic programs for its chroot
# (fingerprint/ingot, built on the computer into prebuilt/ingot/: the RPMB
# pass-through and SSD listener libraries, the bridge and the preload
# shim; never the vendor's files) and its unit, enabled by a vendor wants
# link like omamobile-fp and inert until tools/ingot-fp-provision has put
# the phone's own vendor files in /usr/lib/omamobile-fp-ingot/root.
# fprintd's drop-in and the PAM file below serve both phones.
i=$d/usr/lib/omamobile-fp-ingot
install -Dm755 lib/ingot-fp-stage "$i/ingot-fp-stage"
for f in librpmb.so libssd.so omamobile-fp-shim.so; do
  install -Dm644 "prebuilt/ingot/$f" "$i/bin/$f"
done
install -Dm755 prebuilt/ingot/omamobile-fp-bridge-ingot "$i/bin/omamobile-fp-bridge-ingot"
install -Dm644 vendor/systemd/system/omamobile-fp-ingot.service \
  "$d/usr/lib/systemd/system/omamobile-fp-ingot.service"
ln -sfn ../omamobile-fp-ingot.service "$d/usr/lib/systemd/system/multi-user.target.wants/omamobile-fp-ingot.service"
install -Dm644 vendor/pam.d/omarchy-lock-fingerprint "$d/etc/pam.d/omarchy-lock-fingerprint"
install -Dm644 vendor/systemd/system/fprintd.service.d/omamobile-udfps.conf \
  "$d/usr/lib/systemd/system/fprintd.service.d/omamobile-udfps.conf"
install -Dm755 vendor/systemd/system-sleep/omamobile-fprintd-resume "$d/usr/lib/systemd/system-sleep/omamobile-fprintd-resume"
install -Dm644 vendor/modprobe.d/omamobile-fingerprint-lhbm.conf "$d/usr/lib/modprobe.d/omamobile-fingerprint-lhbm.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-fingerprint/LICENSE"
install -Dm644 version "$d/usr/share/omamobile/fingerprint/version"
