# SPDX-License-Identifier: 0BSD
#
# Omarchy Mobile build of libfprint for the Pixel 7 Pro, 7 and 9a and the
# Solana Saga: upstream libfprint with one more driver, omamobile_udfps
# (omamobile-udfps.c), which reaches the Pixels' under-display sensor through
# omamobile-fp-bridge (packages/omamobile-fingerprint,
# device/cheetah/FINGERPRINT-PLAN.md) and the Saga's rear sensor through its
# bridge, which announces its enrollment's stage count in READY. The device
# is named for the phone from its device tree ("Solana Mobile Saga rear
# fingerprint sensor (Omarchy Mobile)").
# The driver is a "virtual" type device: it appears only when fprintd's
# environment names the bridge's socket (FP_OMAMOBILE_UDFPS, set by
# omamobile-fingerprint's fprintd drop-in), so this build behaves exactly
# like upstream's anywhere else.
#
# Options follow Arch Linux's libfprint 1.94.100-1 (gtk-doc off here).
# pkgrel 1.1 sorts above Arch Linux ARM's 1.94.100-1. Check the driver on the
# computer with test/run (an Arch container, a fake bridge).

pkgname=libfprint
pkgver=1.94.100
pkgrel=1.9
_tag=v$pkgver
pkgdesc="Library for fingerprint readers (Omarchy Mobile: Pixel under-display and Saga rear sensors)"
arch=(aarch64)
url="https://fprint.freedesktop.org/"
license=(LGPL-2.1-or-later)
depends=(gcc-libs glib2 glibc libgudev libgusb openssl pixman)
makedepends=(git glib2-devel gobject-introspection meson pkgconf)
provides=(libfprint-2.so)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=$_tag"
        0001-add-the-omamobile_udfps-driver.patch
        omamobile-udfps.c)
sha256sums=('SKIP'
            '0cc68494adac7512fa8e9eca6b810db196fe2932e4b072bdbb2a992e4c0f09e0'
            '8f3ed01186e61504b8c125b962db4ad8e0d66a60402b29af773ec7c540cd5228')

prepare() {
  cd libfprint
  patch -Np1 -i ../0001-add-the-omamobile_udfps-driver.patch
  cp ../omamobile-udfps.c libfprint/drivers/
}

build() {
  arch-meson libfprint build -D doc=false -D gtk-examples=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
