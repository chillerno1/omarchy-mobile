# SPDX-License-Identifier: MIT
# Maintainer: Derek Ross <derekross@gmail.com>
#
# The Solana Mobile Saga's (ingot) bring-up kernel: its modules and the
# boot images built from it, for omamobile-ingot-boot to write to slot A.
# Nothing compiles here: `./stage KERNEL_OUT IMAGES_DIR` copies the kernel
# build's modules and tools/build-ingot-probe --standalone's images into
# prebuilt/ (or point LINUX_OMAMOBILE_INGOT_PREBUILT at one ./stage filled).
#
# NEVER PUBLISHED: boot_a.img's initramfs carries the developer's SSH
# public key, and the kernel is an unpublished development build.
# tools/build-packages builds it only when named, and only with --local;
# tools/repo-publish refuses an index that lists it.
_prebuilt=${LINUX_OMAMOBILE_INGOT_PREBUILT:-${startdir:-.}/prebuilt}
pkgname=linux-omamobile-ingot
pkgver=$("${startdir:-.}/lib/pkgver" "$(cat "$_prebuilt/kernel.release" 2>/dev/null)" $(cat "$_prebuilt/kernel.commits" 2>/dev/null) 2>/dev/null || echo 0)
pkgrel=$(cat "${startdir:-.}/version")
pkgdesc="The Solana Mobile Saga's bring-up kernel: modules and slot-A boot images (local builds only, never published)"
arch=(aarch64)
url="https://github.com/derekross/linux-omarchy-mobile"
license=(GPL-2.0-only)
depends=(kmod omamobile-ingot-boot)
makedepends=(zstd)
checkdepends=(zstd git)
# The modules are stripped already and the images must stay as built
options=(!strip !debug)

check() {
  "$startdir/test/all"
}

package() {
  [[ $pkgver != 0 ]] || { echo "no staged kernel in $_prebuilt (run ./stage KERNEL_OUT IMAGES_DIR)" >&2; return 1; }
  "$startdir/install" "$pkgdir" "$_prebuilt"
}
