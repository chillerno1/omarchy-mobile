#!/bin/bash
# SPDX-License-Identifier: MIT
# The pacman version of the Saga's bring-up kernel (a development release,
# never a published one):
#
#   lib/pkgver 7.3.0-rc6-omamobile-push1-g837bf17d318a 1301234  ->  7.3.0rc6.r1301234.g837bf17d318a
#   lib/pkgver 7.3.0-rc6-omamobile-push1-00058-g7b0f8b5d18f8     ->  7.3.0rc6.r58.g7b0f8b5d18f8
#
# The count makes pkgver sort upward: given as the second argument
# (./stage takes `git rev-list --count HEAD` from KERNEL_DIR), or else the
# count the release itself carries (-<n>-g<sha>). Keep to one source: the
# two counts differ by the whole upstream history, so switching from the
# first to the second sorts downward. Any local name between -omamobile and
# the count (-push1) is allowed; a -dirty tree is refused, since its
# release names a commit it was not built from. '-' is folded away (pacman
# forbids it), and an rc sorts below its release (7.3.0rc6 < 7.3.0).
#
#   lib/pkgver RELEASE [COMMITS]
set -euo pipefail
rel=${1:?usage: pkgver RELEASE [COMMITS] (RELEASE as in include/config/kernel.release)}
count=${2:-}
re='^([0-9]+)\.([0-9]+)(\.([0-9]+))?(-(rc[0-9]+))?-omamobile((-[a-z][a-z0-9]*)*)(-([0-9]+))?-g([0-9a-f]{7,40})$'
if [[ $rel == *-dirty ]]; then
  echo "pkgver: $rel was built from a tree with uncommitted changes; commit them and build again" >&2
  exit 1
fi
if ! [[ $rel =~ $re ]]; then
  echo "pkgver: $rel is not an Omarchy Mobile kernel release (expected <version>[-rcN]-omamobile[-<name>][-<n>]-g<sha>)" >&2
  exit 1
fi
v=${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[4]:-0}${BASH_REMATCH[6]}
n=${BASH_REMATCH[10]} sha=${BASH_REMATCH[11]}
[[ -n $count ]] || count=$n
[[ $count =~ ^[0-9]+$ ]] || { echo "pkgver: $rel needs its commit count (KERNEL_DIR, git rev-list --count HEAD) as the second argument" >&2; exit 1; }
echo "$v.r$((10#$count)).g$sha"
