# SPDX-License-Identifier: MIT
# Maintainer: Derek Ross <derekross@gmail.com>
pkgname=omamobile-device-ingot
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile support for the Solana Mobile Saga (ingot): storage guard, USB networking, its own firmware, ADSP, Bluetooth, Wi-Fi policy and sound"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
# util-linux: mount, umount, flock and dmesg (omamobile-ingot-firmware);
# bluez-utils: btmgmt (omamobile-bt-addr); alsa-ucm-conf: the library files
# the sound card's profile includes; linux-firmware-qcom: the audio topology
# the firmware link points at.
depends=(bash coreutils findutils systemd util-linux bluez-utils omamobile-keyring
         alsa-ucm-conf linux-firmware-qcom)
provides=(omamobile-device)
conflicts=(omamobile-device)
backup=(etc/pacman.d/omamobile-mirrorlist)
install=omamobile-device-ingot.install
makedepends=(gcc)
# test/all parses the built board file the way ath11k does
checkdepends=(python)
optdepends=('pipewire: saga-mic-talk records and plays back through it'
            'wireplumber: saga-mic-talk finds the microphone source with wpctl'
            'python: saga-mic-talk measures the recording')

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
