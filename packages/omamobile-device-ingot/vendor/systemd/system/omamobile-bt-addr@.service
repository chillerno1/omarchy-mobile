# Started by 80-omamobile-bt-addr.rules for the WCN6855 Bluetooth controller.
# A service rather than a udev RUN, because udev's sandbox has no Bluetooth
# sockets. Gives an unconfigured controller a stable address derived from
# the machine id; does nothing to a configured one.
[Unit]
Description=Give Bluetooth controller %i a stable address
Before=bluetooth.service
ConditionPathExists=/etc/machine-id

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-bt-addr %i
TimeoutStartSec=60
