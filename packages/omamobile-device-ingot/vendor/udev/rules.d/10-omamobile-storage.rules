# SPDX-License-Identifier: MIT
# Omarchy Mobile storage guard, continued in Arch. The initramfs marks every UFS
# partition read-only except userdata, and removes the whole-disk node of the
# main LUN. udev would recreate /dev/sda, so make the whole-disk node
# inaccessible and keep desktop tools from touching any Android partition.
# The Saga's UFS has eight LUNs (sda to sdh).
SUBSYSTEM=="block", KERNEL=="sda", MODE="0000", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", KERNEL=="sd[a-z][0-9]*", ENV{ID_PART_ENTRY_NAME}!="userdata", ENV{UDISKS_IGNORE}="1"
