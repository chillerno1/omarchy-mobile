+class CameraSensorHelperImx766 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx766()
+	{
+		/*
+		 * Assumed 64 at 10 bits, the usual value for Sony sensors of
+		 * this family; not measured yet, to be checked on a dark raw
+		 * frame from the Solana Saga's main camera.
+		 */
+		blackLevel_ = 4096;
+		/*
+		 * The global analogue gain register on a 14-bit scale: gain
+		 * is 16384 / (16384 - code). The driver offers codes 0 to
+		 * 16128, 1x to 64x.
+		 */
+		gain_ = AnalogueGainLinear{ 0, 16384, -1, 16384 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx766", CameraSensorHelperImx766)
+
 class CameraSensorHelperOv01a10 : public CameraSensorHelper
