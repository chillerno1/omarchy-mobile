new file mode 100644
--- /dev/null
+++ b/src/ipa/simple/data/imx563.yaml
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: CC0-1.0
+#
+# Sony IMX563 (the Solana Saga's ultrawide camera), not calibrated yet:
+# the uncalibrated defaults with the black level, 64 at 10 bits, the same
+# value as the sensor's helper: assumed, not measured yet (to be checked on
+# a dark raw frame). No colour matrix until one is fitted on daylight
+# shots. Fixed focus: no Af.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+      blackLevel: 4096
+  - Awb:
+  # Defaults for applications that do not set the controls.
+  - Adjust:
+      contrast: 1.2
+      saturation: 1.1
+  # Luma and chroma noise reduction and sharpening, scaled with the gain
+  - Detail:
+      sharpen: 0.6
+      denoise: 0.015
+      chromaDenoise: 0.03
+  - Agc:
+...
