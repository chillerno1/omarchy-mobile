# SPDX-License-Identifier: 0BSD
#
# Omarchy Mobile build of tqftpserv, the TFTP server the Qualcomm modem
# (MPSS) reaches over QRTR (AF_QIPCRTR) to read its carrier configuration
# (/readonly/firmware/image/modem_pr/mcfg/...) and to keep small read-write
# files (/readwrite/...), for the Solana Mobile Saga (ingot). Neither Arch
# Linux nor Arch Linux ARM packages it; derived from the AUR's tqftpserv
# PKGBUILD, updated to the v1.3 release. Choices:
#  - links libqrtr (qrtr-git from Arch Linux ARM's [aur] provides qrtr, with
#    qrtr.pc), and liblzma and libzstd so it can serve .xz and .zst firmware.
#  - 0001, 0002: the two upstream commits after v1.3. 0001 declares
#    asprintf() (_GNU_SOURCE), which newer GCC needs; 0002 installs
#    populate-readwrite.sh in /usr/libexec/tqftpserv instead of /usr/bin.
#  - tqftpserv.service and tqftpserv-populate-readwrite.service are
#    installed, not enabled. The second mounts the persist partition and
#    copies rfs/msm/mpss into /var/lib/tqftpserv: don't enable it before
#    that has been checked on the phone.

pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc='TFTP server over AF_QIPCRTR, for Qualcomm remote processors'
arch=(aarch64)
url='https://github.com/linux-msm/tqftpserv'
license=(BSD-3-Clause)
depends=(glibc qrtr xz zstd)
makedepends=(meson)
source=("$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/tqftpserv/archive/refs/tags/v$pkgver.tar.gz"
        0001-translate-define-_GNU_SOURCE-for-asprintf.patch
        0002-tqftpserv-populate-readwrite-use-libexec.patch)
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f'
            'e5da0be8993c52b3e54bdf8097a3aa7007aaf86112b61f0b48fad6875b16abd8'
            'e8d78e878ca59d5035099da3b756149e4e513727cc86c3893a5c720b295f4f69')

prepare() {
  cd "$pkgname-$pkgver"
  patch -Np1 -i ../0001-translate-define-_GNU_SOURCE-for-asprintf.patch
  patch -Np1 -i ../0002-tqftpserv-populate-readwrite-use-libexec.patch
}

build() {
  arch-meson "$pkgname-$pkgver" build \
    -Dsystemd-unit-prefix=/usr/lib/systemd/system
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
