# SPDX-License-Identifier: MIT
# Solana Mobile Saga (ingot, SM8475): merged after kernel/configs/omamobile.config.
# First light runs from RAM with an initramfs that loads no modules, so the
# chain to the USB gadget and the buttons is built in.

# USB 2.0 gadget: eUSB2 PHY and the Qualcomm DWC3 glue
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_USB_DWC3_QCOM=y

# RPMh regulators and power domains that the PHY and the glue need
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8450=y

# Pins and buttons: TLMM (the SM8450 driver until SM8475's lands), PMIC GPIOs,
# the PON power key and Volume Down, Volume Up through gpio-keys
CONFIG_PINCTRL_SM8450=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y

# Reboot reasons: "reboot bootloader" writes PMK8350's SDAM, which ABL reads
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_POWER_RESET_QCOM_PON=y

# Display: SM8475 display clocks, the MSM DPU/DSI driver and the E667 panel
CONFIG_SM_DISPCC_8450=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_EVERDISPLAY_E667=y
# DRM_MSM can only be built in when these are too
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_SMEM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_DISPLAY_HELPER=y

# Touch: FocalTech FT3519 on QUP I2C4, with GPI DMA
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# UFS, read-only behind the initramfs guard
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
