#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/ingot-fp-stage against a fake phone, in an unprivileged user
# namespace (unshare -Ur): host /dev, /sys and /run in a temporary tree,
# "device nodes" as files reading "c MAJ:MIN" (OMAMOBILE_FP_TEST=1 and
# OMAMOBILE_FP_TEST_ROOT). Nothing on this machine's real /dev is touched.
#
#   check                    -> preconditions met; refused without a stub, with
#                               the vendor's library as the stub, with a stub
#                               naming a device path, without /dev/qseecom
#   the overrides            -> ignored without OMAMOBILE_FP_TEST=1
#   audit                    -> exactly the allowlisted nodes, from the host's
#                               numbers; the stubs over the vendor's; persist
#                               in the chroot's /proc/mounts; and refused for
#                               an extra node, a wrong node, an extra mount,
#                               the vendor's library over the stub
#   hal (static fakes of qseecomd and the HAL host; needs gcc -static)
#                            -> the logdw reader names the sender, the
#                               listeners are seen, the HAL host starts after
#                               them, chipid 5f83 gives PASS, stop in order
#   audit, socket directory  -> the host's socket directory bound once, empty;
#                               refused for a file planted in it, another
#                               directory in its place, a second bind of it
#   bridge (a static fake bridge)
#                            -> started after the listeners, with --socket
#                               and --state; its socket on the host at
#                               run/omamobile-fp/sock, root's 0600 in a
#                               root-only 0700 directory; a client outside the
#                               namespace gets READY 0 0 0 and answers
#                               (omamobile-fp-ctl STATUS, LIST); the state
#                               directories; ingot-fp-stage stop stops the
#                               bridge before qseecomd and removes the socket
#                               directory
#   tools/ingot-fp-s4-test   -> its steps (but fprintd and lock) against the
#                               fakes, in order, each PASS; one FAIL that
#                               prints the stack's log; the stubs' requests
#                               counted once (not their liblog copies)
#   ingot-fp-s4-test nofinger, morning (no terminal: setsid, stdin /dev/null,
#                               output into a pipe)
#                            -> nofinger: every part PASS, fprintd SKIP, the
#                               stack stopped (or left running); morning:
#                               the ">>> FINGER:" lines, every part PASS with
#                               fake fprintd tools, the stack left running
#                               and the pipe closed; a LIST that never ends
#                               and a failing enrolment: the stack restarted,
#                               FAIL, the parts that need enrolment SKIP, the
#                               rest still run, exit 1
#   lint                     -> shellcheck on both scripts, if installed
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
STAGE=$HERE/ingot-fp-stage
fail() { echo "not ok - $*" >&2; [[ -f ${out:-/nonexistent} ]] && sed 's/^/    /' "$out" >&2; exit 1; }
pass() { echo "ok - $*"; }

unshare -Ur true 2>/dev/null || { echo "skip: no unprivileged user namespaces (unshare -Ur)"; exit 0; }

t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
out=$t/out

# --- the fake phone ---
H=$t/host IMG=$t/image BIN=$t/bin
mkdir -p "$H/dev/dma_heap" "$H/sys/bus/clockevents/devices/clockevent0" \
  "$H/sys/bus/clocksource/devices/clocksource0" "$H/sys/devices/platform/fingerprint" "$H/run"
node() { echo "c $2" > "$H/dev/$1"; }
node null 1:3; node zero 1:5; node full 1:7; node random 1:8; node urandom 1:9
node qseecom 236:0; node blfp 10:120; node dma_heap/default_cma_region 249:2
echo "DEVNAME=arch_sys_timer" > "$H/sys/bus/clockevents/devices/clockevent0/uevent"
echo "DEVNAME=arch_sys_counter" > "$H/sys/bus/clocksource/devices/clocksource0/uevent"
echo 5f83 > "$H/sys/devices/platform/fingerprint/chipid"
echo 1.0 > "$H/sys/devices/platform/fingerprint/version"
mkdir -p "$IMG/system/bin" "$IMG/system/lib64" "$IMG/apex/com.android.runtime/bin" \
  "$IMG/vendor/bin" "$IMG/vendor/lib64/hw" "$IMG/vendor/firmware_mnt/image"
ln -s /apex/com.android.runtime/bin/linker64 "$IMG/system/bin/linker64"
: > "$IMG/apex/com.android.runtime/bin/linker64"
printf 'vendor librpmb /dev/block/bootdevice /dev/ufs-bsg\n' > "$IMG/vendor/lib64/librpmb.so"
printf 'vendor libssd /dev/block/bootdevice/by-name/ssd\n' > "$IMG/vendor/lib64/libssd.so"
: > "$IMG/vendor/lib64/libQSEEComAPI.so"
: > "$IMG/vendor/lib64/hw/fingerprint.betterlife.so"
: > "$IMG/vendor/firmware_mnt/image/btlap64.mdt"
printf 'ro.arch=fake\n# comment\nro.product.vendor.device=ingot\n' > "$IMG/vendor/build.prop"
: > "$IMG/vendor/bin/qseecomd"
mkdir -p "$BIN"
printf 'stub rpmb: every request fails\n' > "$BIN/librpmb.so"
printf 'stub ssd: every request fails\n' > "$BIN/libssd.so"
: > "$BIN/omamobile-fp-halhost"
STATE=$t/state

st() { # mode args...: the stage, as fake root, on the fake phone
  local m=$1; shift
  ${TIMEOUT:+timeout "$TIMEOUT"} unshare -Ur env OMAMOBILE_FP_TEST=1 OMAMOBILE_FP_TEST_ROOT="$H" "$STAGE" "$m" \
    --image "$IMG" --bin "$BIN" --state "$STATE" "$@"
}

# --- check ---
st check > "$out" 2>&1 || fail "check on a good fake phone"
grep -q 'preconditions met' "$out" || fail "check: no 'preconditions met'"
grep -q "node /dev/dma_heap/qcom,qseecom-ta <- host $H/dev/dma_heap/default_cma_region (c 249:2)" "$out" ||
  fail "check: the qcom,qseecom-ta alias"
[[ ! -e $STATE ]] || fail "check created the state directory"
pass "check: preconditions met, changes nothing"

mv "$BIN/libssd.so" "$t/libssd.so"
st check > "$out" 2>&1 && fail "check without libssd.so"
grep -q "no stub $BIN/libssd.so" "$out" || fail "check: missing stub not named"
mv "$t/libssd.so" "$BIN/libssd.so"
pass "check: refused without a stub"

cp "$BIN/librpmb.so" "$t/librpmb.so"
cp "$IMG/vendor/lib64/librpmb.so" "$BIN/librpmb.so"
st check > "$out" 2>&1 && fail "check with the vendor's librpmb.so"
grep -q "is the vendor's librpmb.so" "$out" || fail "check: vendor library not named"
pass "check: refused with the vendor's library as the stub"

printf 'stub that opens /dev/block/sda\n' > "$BIN/librpmb.so"
st check > "$out" 2>&1 && fail "check with a stub naming /dev/block"
grep -q 'contains "/dev/block"' "$out" || fail "check: device path not named"
cp "$t/librpmb.so" "$BIN/librpmb.so"
pass "check: refused with a device path in a stub"

mv "$H/dev/qseecom" "$t/qseecom"
st check > "$out" 2>&1 && fail "check without /dev/qseecom"
grep -q "no character device $H/dev/qseecom" "$out" || fail "check: missing qseecom not named"
mv "$t/qseecom" "$H/dev/qseecom"
pass "check: refused without /dev/qseecom"

env -u OMAMOBILE_FP_TEST OMAMOBILE_FP_TEST_ROOT="$H" "$STAGE" check --image "$IMG" --bin "$BIN" \
  --state "$STATE" > "$out" 2>&1 || true
grep -q "$H/dev" "$out" && fail "OMAMOBILE_FP_TEST_ROOT honoured without OMAMOBILE_FP_TEST=1"
grep -q '/dev/qseecom' "$out" || fail "the real /dev not checked without OMAMOBILE_FP_TEST=1"
pass "the overrides are ignored without OMAMOBILE_FP_TEST=1"

# --- audit ---
st audit > "$out" 2>&1 || fail "audit on a good fake phone"
grep -q 'audit passed' "$out" || fail "audit: no 'audit passed'"
got=$(sed -n 's/^ingot-fp:   c \([0-9:]*\) [^ ]* [0-9]* \(\/dev\/[^ ]*\) .*/\2 \1/p' "$out" | sort | tr '\n' ' ')
want="/dev/blfp 10:120 /dev/dma_heap/qcom,qseecom 249:2 /dev/dma_heap/qcom,qseecom-ta 249:2 /dev/full 1:7 /dev/null 1:3 /dev/qseecom 236:0 /dev/random 1:8 /dev/urandom 1:9 /dev/zero 1:5 "
[[ $got == "$want" ]] || fail "audit: /dev is '$got', want '$want'"
grep -q 'REFUSED' "$out" && fail "audit: a REFUSED line on a good phone"
grep -q "/vendor/lib64/librpmb.so = $BIN/librpmb.so" "$out" || fail "audit: stub over librpmb.so"
grep -q "/vendor/lib64/libssd.so = $BIN/libssd.so" "$out" || fail "audit: stub over libssd.so"
grep -q '  /mnt/vendor/persist: bind from' "$out" || fail "audit: persist bind"
[[ -d $STATE/data/vendor/tzstorage && -d $STATE/data/vendor/blfp/pic && -d $STATE/persist/data ]] ||
  fail "audit: the state directories"
pass "audit: exactly the allowlist, the stubs, persist from the state directory"

for f in dev-extra dev-wrong mount-extra stub-vendor; do
  OMAMOBILE_FP_TEST_INJECT=$f st audit > "$out" 2>&1 && fail "audit passed with $f"
  { grep -q 'REFUSED' "$out" && grep -q 'audit failed: nothing started' "$out"; } || fail "audit with $f: no refusal"
done
pass "audit: refused an extra node, a wrong node, an extra mount, the vendor's library"

st audit > "$out" 2>&1 || fail "audit (socket directory)"
grep -q "  /dev/socket/omamobile-fp: bind of the host's $H/run/omamobile-fp/sock" "$out" || fail "audit: socket directory bind"
grep -q "  $H/run/omamobile-fp/sock: empty" "$out" || fail "audit: socket directory empty"
for f in "sock-extra:holds 'f planted'" "sock-wrong:is not the host's" "sock-twice:/tmp/s: unexpected mount point"; do
  OMAMOBILE_FP_TEST_INJECT=${f%%:*} st audit > "$out" 2>&1 && fail "audit passed with ${f%%:*}"
  { grep -q "${f#*:}.*REFUSED" "$out" && grep -q 'audit failed: nothing started' "$out"; } ||
    fail "audit with ${f%%:*}: no refusal for '${f#*:}'"
done
pass "audit: the socket directory, once and empty; refused a planted file, another directory, a second bind"

mkdir -p "$H/run/omamobile-fp/sock" && echo $$ > "$H/run/omamobile-fp/ns.pid" && : > "$H/run/omamobile-fp/sock/bridge.sock"
st audit > "$out" 2>&1 && fail "audit with the Pixel runner's stack up"
grep -q "omamobile-fp-chroot's stack runs (PID $$)" "$out" || fail "audit: the Pixel runner's stack not named"
[[ -e $H/run/omamobile-fp/sock/bridge.sock ]] || fail "audit: took the Pixel runner's socket"
rm -rf "$H/run/omamobile-fp"
pass "audit, bridge: refused while the Pixel runner's stack owns the socket directory"

# --- hal, with static fakes (the chroot has no bionic here) ---
if printf 'int main(void){return 0;}\n' > "$t/cc.c" && gcc -static -o "$t/cc" "$t/cc.c" 2>/dev/null; then
  cat > "$t/fake.c" <<'EOF'
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <signal.h>
#include <unistd.h>
#include <sys/socket.h>
#include <sys/un.h>
static void logdw(const char *tag, const char *msg)
{
	struct sockaddr_un a = { .sun_family = AF_UNIX, .sun_path = "/dev/socket/logdw" };
	unsigned char b[256] = { 0 };
	size_t n = 11;
	int s = socket(AF_UNIX, SOCK_DGRAM, 0);
	b[0] = 0; b[1] = 7; b[n++] = 4;
	strcpy((char *)b + n, tag); n += strlen(tag) + 1;
	strcpy((char *)b + n, msg); n += strlen(msg) + 1;
	sendto(s, b, n, 0, (struct sockaddr *)&a, sizeof(a));
	close(s);
}
static volatile sig_atomic_t done;
static void term(int s) { (void)s; done = 1; }
/* the line protocol, canned: READY 0 0 0; ENROLL enrols id 7 in three
 * touches (a file in the HAL's template directory, so it survives a
 * restart; ERROR 1 after one touch while the state has "fail-enroll");
 * LIST never ends while it has "hang-list"; AUTH alternates MATCH 7 (if
 * enrolled) and NOMATCH; LIST and DELETE read and remove the files;
 * STATUS: OK */
#define FPDATA "/data/vendor_de/0/fpdata"
static int auths;
static void answer(FILE *fp, const char *line)
{
	char f[64];
	int id;

	if (!strncmp(line, "STATUS", 6)) {
		fputs("OK\n", fp);
	} else if (!strncmp(line, "ENROLL", 6) && !access("/data/vendor/omamobile-fp/fail-enroll", F_OK)) {
		fputs("FINGER NEEDED\nACQUIRED 1 0\nPROGRESS 7 2\nERROR 1\n", fp);
	} else if (!strncmp(line, "ENROLL", 6)) {
		fputs("FINGER NEEDED\nACQUIRED 1 0\nPROGRESS 7 2\nACQUIRED 1 0\nPROGRESS 7 1\n"
		      "ACQUIRED 1 0\nPROGRESS 7 0\n", fp);
		FILE *t = fopen(FPDATA "/7", "w");
		if (t) {
			fclose(t);
			fputs("ENROLLED 7\n", fp);
		} else {
			fputs("ERROR 1\n", fp);
		}
	} else if (!strncmp(line, "AUTH", 4)) {
		fputs("FINGER NEEDED\nACQUIRED 1 0\n", fp);
		fputs(++auths % 2 && !access(FPDATA "/7", F_OK) ? "MATCH 7\n" : "NOMATCH\n", fp);
	} else if (!strncmp(line, "LIST", 4) && !access("/data/vendor/omamobile-fp/hang-list", F_OK)) {
		/* a HAL that ends no enumerate: no answer */
	} else if (!strncmp(line, "LIST", 4)) {
		fputs(access(FPDATA "/7", F_OK) ? "LIST\n" : "LIST 7\n", fp);
	} else if (sscanf(line, "DELETE %d", &id) == 1) {
		snprintf(f, sizeof(f), FPDATA "/%d", id);
		if (unlink(f))
			fputs("ERROR 6\n", fp);
		else
			fprintf(fp, "DELETED %d\n", id);
	} else {
		fputs("ERROR 2\n", fp);
	}
}
static int bridge(int argc, char **argv)
{
	const char *path = "", *state = "";
	struct sockaddr_un a = { .sun_family = AF_UNIX };
	struct sigaction sa = { .sa_handler = term };	/* no SA_RESTART */
	char line[128], f[256];
	int s, c, i;
	FILE *fp;

	sigaction(SIGTERM, &sa, NULL);
	for (i = 1; i + 1 < argc; i++) {
		if (!strcmp(argv[i], "--socket"))
			path = argv[++i];
		else if (!strcmp(argv[i], "--state"))
			state = argv[++i];
	}
	printf("bridge fake: --socket %s --state %s uid %d\n", path, state, (int)getuid());
	snprintf(f, sizeof(f), "%s/secret", state);
	fp = fopen(f, "w");
	printf("bridge fake: %s %s\n", f, fp ? "written" : "NOT writable");
	if (fp)
		fclose(fp);
	strncpy(a.sun_path, path, sizeof(a.sun_path) - 1);
	s = socket(AF_UNIX, SOCK_STREAM, 0);
	if (bind(s, (struct sockaddr *)&a, sizeof(a)) || chmod(path, 0600) || listen(s, 2)) {
		perror("bridge fake: listen");
		return 1;
	}
	printf("bridge fake: ready on %s\n", path);
	fflush(stdout);
	while (!done) {
		c = accept(s, NULL, NULL);
		if (c < 0)
			continue;
		fp = fdopen(c, "r+");
		fputs("READY 0 0 0\n", fp);
		fflush(fp);
		while (!done && fgets(line, sizeof(line), fp)) {
			answer(fp, line);
			fflush(fp);
		}
		fclose(fp);
	}
	printf("bridge fake: TERM\n");
	return 0;
}
int main(int argc, char **argv)
{
	signal(SIGTERM, term);
	if (strstr(argv[0], "qseecomd")) {
		logdw("QSEECOMD", "listener services: Started (Listener ID = 8192)");
		logdw("QSEECOMD", "listener services: Started (Listener ID = 12288)");
		/* as the RPMB stub logs a request on its stderr */
		printf("omamobile-rpmb-stub[%d]: listener 0x2000 request 1: command 0x101, failing it; 00000101\n",
		       (int)getpid());
		/* its liblog copy, as the shim prints it: not a second request */
		printf("I omamobile-rpmb-stub[%d]: listener 0x2000 request 1: command 0x101, failing it; 00000101\n",
		       (int)getpid());
		fflush(stdout);
		while (!done)
			pause();
		printf("qseecomd fake: TERM\n");
		return 0;
	}
	if (strstr(argv[0], "bridge"))
		return bridge(argc, argv);
	printf("halhost fake: %s %s %s uid %d\n", argc > 1 ? argv[1] : "", argc > 2 ? argv[2] : "",
	       argc > 3 ? argv[3] : "", (int)getuid());
	FILE *f = fopen("/dev/blfp", "r");
	char l[64] = "";
	if (f && fgets(l, sizeof(l), f))
		printf("halhost fake: /dev/blfp reads %s", l);
	logdw("BtlFpHal", "chip id 0x5f83");
	logdw("BtlFpHal", "netlink: irq event, finger down");
	fflush(stdout);
	sleep(1);
	return 0;
}
EOF
  gcc -static -O1 -o "$t/fake" "$t/fake.c"
  cp "$t/fake" "$IMG/vendor/bin/qseecomd"
  cp "$t/fake" "$BIN/omamobile-fp-halhost"
  chmod 0755 "$IMG/vendor/bin/qseecomd" "$BIN/omamobile-fp-halhost"
  TIMEOUT=60 st hal --seconds 1 > "$out" 2>&1 || fail "hal with the fakes"
  grep -q '^\[qseecomd\] [0-9]*/7 I QSEECOMD: listener services: Started (Listener ID = 8192)' "$out" ||
    fail "hal: the logdw reader's line for qseecomd"
  grep -q 'listeners registered: 2 started' "$out" || fail "hal: listeners not seen"
  grep -q '^\[halhost\] halhost fake: --seconds 1 open uid 0' "$out" || fail "hal: the HAL host's arguments"
  grep -q '^\[halhost\] halhost fake: /dev/blfp reads c 10:120' "$out" || fail "hal: /dev/blfp in the chroot"
  grep -q '^\[omamobile-fp-ha\] [0-9]*/7 I BtlFpHal: chip id 0x5f83' "$out" || fail "hal: the HAL host's log line"
  grep -q 'S3 PASS: chipid 5f83' "$out" || fail "hal: no PASS"
  grep -q '^\[qseecomd\] qseecomd fake: TERM' "$out" || fail "hal: qseecomd not stopped with TERM"
  [[ $(grep -n 'S3 PASS' "$out" | cut -d: -f1) -lt $(grep -n 'qseecomd fake: TERM' "$out" | cut -d: -f1) ]] ||
    fail "hal: qseecomd stopped before the report"
  pass "hal: log reader, listeners, HAL host after them, PASS, ordered stop"

  # --- bridge, with a fake bridge ---
  cp "$t/fake" "$BIN/omamobile-fp-bridge-ingot"
  chmod 0755 "$BIN/omamobile-fp-bridge-ingot"
  SD=$H/run/omamobile-fp/sock
  out=$t/bridge.out
  TIMEOUT=60 st bridge > "$out" 2>&1 &
  bpid=$!
  for ((i = 0; i < 300; i++)); do
    grep -q 'stage bridge running' "$out" 2>/dev/null && break
    kill -0 "$bpid" 2>/dev/null || break
    sleep 0.1
  done
  grep -q 'stage bridge running' "$out" || fail "bridge: not running"
  grep -q '^\[bridge\] bridge fake: --socket /dev/socket/omamobile-fp/bridge.sock --state /data/vendor/omamobile-fp uid 0' "$out" ||
    fail "bridge: its arguments"
  grep -q '^\[bridge\] bridge fake: /data/vendor/omamobile-fp/secret written' "$out" || fail "bridge: state not writable"
  [[ $(grep -n 'listeners registered' "$out" | cut -d: -f1) -lt $(grep -n 'starting bridge' "$out" | cut -d: -f1) ]] ||
    fail "bridge: started before the listeners"
  [[ -S $SD/bridge.sock ]] || fail "bridge: no socket on the host at $SD/bridge.sock"
  [[ $(stat -c '%u %a' "$SD/bridge.sock") == "$(id -u) 600" ]] || fail "bridge: socket is $(stat -c '%u %a' "$SD/bridge.sock")"
  [[ $(stat -c '%u %a' "$SD") == "$(id -u) 700" ]] || fail "bridge: socket directory is $(stat -c '%u %a' "$SD")"
  [[ $(stat -c '%a' "$STATE/data/vendor/omamobile-fp") == 700 && -d $STATE/data/vendor_de/0/fpdata ]] ||
    fail "bridge: the state directories"
  grep -q "$SD: s bridge.sock (root, 0600; directory root, 0700)" "$out" || fail "bridge: the socket audit"
  CTL=$HERE/../packages/omamobile-fingerprint/lib/omamobile-fp-ctl
  "$CTL" --socket "$SD/bridge.sock" --timeout 5 STATUS > "$t/ctl" 2>&1 || { cat "$t/ctl" >&2; fail "bridge: ctl STATUS"; }
  { grep -qx '<- READY 0 0 0' "$t/ctl" && grep -qx '<- OK' "$t/ctl"; } || { cat "$t/ctl" >&2; fail "bridge: STATUS answers"; }
  { "$CTL" --socket "$SD/bridge.sock" --timeout 5 LIST > "$t/ctl" 2>&1 && grep -qx '<- LIST' "$t/ctl"; } ||
    { cat "$t/ctl" >&2; fail "bridge: ctl LIST"; }
  pass "bridge: after the listeners, socket on the host (0600, directory 0700), a client outside gets READY 0 0 0"

  env OMAMOBILE_FP_TEST=1 OMAMOBILE_FP_TEST_ROOT="$H" "$STAGE" stop > "$t/stop" 2>&1 || { cat "$t/stop" >&2; fail "stop"; }
  wait "$bpid" || true
  grep -q '^\[bridge\] bridge fake: TERM' "$out" || fail "bridge: not stopped with TERM"
  grep -q '^\[qseecomd\] qseecomd fake: TERM' "$out" || fail "bridge: qseecomd not stopped"
  [[ $(grep -n 'bridge fake: TERM' "$out" | cut -d: -f1) -lt $(grep -n 'qseecomd fake: TERM' "$out" | cut -d: -f1) ]] ||
    fail "bridge: qseecomd stopped before the bridge"
  [[ ! -e $SD ]] || fail "bridge: socket directory left after stop"
  env OMAMOBILE_FP_TEST=1 OMAMOBILE_FP_TEST_ROOT="$H" "$STAGE" stop 2>&1 | grep -c 'no stage running' > /dev/null ||
    fail "stop with nothing running"
  pass "bridge: stop takes the bridge down before qseecomd, removes the socket directory"

  # --- tools/ingot-fp-s4-test, steps against the fakes ---
  S4LOGS=$t/s4
  s4() {
    OMAMOBILE_FP_TEST=1 OMAMOBILE_FP_TEST_ROOT="$H" INGOT_FP_STAGE_WRAP="unshare -Ur" INGOT_FP_IMAGE="$IMG" \
      INGOT_FP_BIN="$BIN" INGOT_FP_STATE="$STATE" INGOT_FP_LOGS="$S4LOGS" INGOT_FP_YES=1 INGOT_FP_SECONDS=2 \
      INGOT_FP_GAP=1 timeout 180 "$HERE/ingot-fp-s4-test" "$@"
  }
  s4ok() { # step [args]: PASS, else fail with its output
    out=$t/s4.$1.out
    s4 "$@" > "$out" 2>&1 || fail "s4 $1"
    grep -q "^S4 $1: PASS" "$out" || fail "s4 $1: no PASS"
  }
  echo 3 > "$H/sys/devices/platform/fingerprint/irq_count"
  # the "interrupts" arrive once the HAL runs
  ( for ((i = 0; i < 600; i++)); do
      grep -q 'stage hal running' "$H/run/omamobile-fp-ingot/stage.log" 2>/dev/null && break; sleep 0.1
    done; echo 9 > "$H/sys/devices/platform/fingerprint/irq_count" ) &
  : > "$H/run/omamobile-fp-ingot/stage.log"
  s4ok irq
  grep -q 'irq_count rose by 6' "$out" || fail "s4 irq: the count"
  grep -q 'netlink: irq event, finger down' "$out" || fail "s4 irq: the HAL's line"
  s4ok bridge
  grep -q 'READY gives no stage count' "$out" || fail "s4 bridge: READY's stage count"
  s4ok enrol
  grep -q 'PROGRESS lines: 3 (first remaining: 2)' "$out" || fail "s4 enrol: the PROGRESS count"
  [[ $(cat "$S4LOGS/enrolled-id") == 7 ]] || fail "s4 enrol: the saved id"
  s4ok verify
  s4ok storage
  grep -q 'rpmb: 2 requests, by command: 0x101 init x2' "$out" || fail "s4 storage: the stub's requests (one per start: irq, bridge)"
  grep -q 'TrustZone asked for RPMB' "$out" || fail "s4 storage: the RPMB verdict"
  grep -q ' data/vendor_de/0/fpdata/7$' "$out" || fail "s4 storage: the template file in the listing"
  s4ok persist
  grep -q 'MATCH 7 after the restart' "$out" || fail "s4 persist: AUTH after the restart"
  s4ok delete
  [[ ! -e $STATE/data/vendor_de/0/fpdata/7 ]] || fail "s4 delete: the template is still there"
  s4ok stop
  [[ ! -e $H/run/omamobile-fp/sock ]] || fail "s4 stop: the socket directory is still there"
  out=$t/s4.fail.out
  s4 verify 7 > "$out" 2>&1 && fail "s4 verify without a stack passed"
  { grep -q '^S4 verify: FAIL (no stack running' "$out" && grep -q -- '--- the stack: last 40 lines' "$out"; } ||
    fail "s4 verify without a stack: no FAIL with the stack's log"
  (($(find "$S4LOGS" -name '*.log' | wc -l) == 9)) || fail "s4: a log per step run"
  pass "ingot-fp-s4-test: irq, bridge, enrol, verify, storage, persist, delete, stop against the fakes; a failure shows the stack's log"

  # --- the aggregates, as over "ssh phone cmd": no terminal, stdin /dev/null,
  # output into a pipe that must close although the stack runs on ---
  mkdir -p "$H/sys/module/qcom_qseecom_user" "$H/sys/module/betterlife_fp"
  agg() { # out args...: no controlling terminal, stdin /dev/null, stdout a pipe
    local o=$1; shift
    OMAMOBILE_FP_TEST=1 OMAMOBILE_FP_TEST_ROOT="$H" INGOT_FP_STAGE_WRAP="unshare -Ur" INGOT_FP_IMAGE="$IMG" \
      INGOT_FP_BIN="$BIN" INGOT_FP_STATE="$STATE" INGOT_FP_LOGS="$S4LOGS" INGOT_FP_SECONDS=2 INGOT_FP_GAP=1 \
      timeout 300 setsid -w "$HERE/ingot-fp-s4-test" "$@" < /dev/null 2>&1 | cat > "$o"
  }
  row() { grep -cE "^  $2 +$3 " "$1" > /dev/null || fail "s4 $4: the summary's $2 is not $3"; }
  out=$t/s4.nofinger.out
  agg "$out" nofinger || fail "s4 nofinger"
  grep -q '^S4 nofinger: PASS' "$out" || fail "s4 nofinger: no PASS"
  for r in preflight hal bridge storage restart stop; do row "$out" "$r" PASS nofinger; done
  row "$out" fprintd SKIP nofinger
  grep -q 'S3 PASS: chipid 5f83' "$out" || fail "s4 nofinger: the hal stage's PASS"
  grep -q 'no enrolled id saved' "$out" || fail "s4 nofinger: the restart without an enrolled id"
  grep -c '>>> FINGER:' "$out" > /dev/null && fail "s4 nofinger: a finger prompt"
  grep -c '/dev/tty' "$out" > /dev/null && fail "s4 nofinger: tried the terminal"
  [[ ! -e $H/run/omamobile-fp/sock ]] || fail "s4 nofinger: the stack is left running"
  pass "ingot-fp-s4-test nofinger without a terminal: every part PASS, fprintd SKIP, no finger prompt, the stack stopped"

  # fprintd, faked: our "libfprint", the drop-in, and the commands
  FB=$t/fakebin
  mkdir -p "$FB" "$H/usr/lib/systemd/system/fprintd.service.d"
  echo 'fake omamobile_udfps' > "$H/usr/lib/libfprint-2.so.2.0.0"
  echo 'Environment=FP_OMAMOBILE_UDFPS=/run/omamobile-fp/sock/bridge.sock' > "$H/usr/lib/systemd/system/fprintd.service.d/omamobile-udfps.conf"
  # shellcheck disable=SC2016  # the fakes' own $1
  printf '#!/bin/sh\n[ "$1" = show ] && echo "Environment=FP_OMAMOBILE_UDFPS=/run/omamobile-fp/sock/bridge.sock"\nexit 0\n' > "$FB/systemctl"
  # shellcheck disable=SC2016
  printf '#!/bin/sh\necho "found 1 devices"\necho "User $1 has no fingers enrolled for Under-display fingerprint sensor (Omarchy Mobile)."\n' > "$FB/fprintd-list"
  printf '#!/bin/sh\necho "Enroll result: enroll-stage-passed"\necho "Enroll result: enroll-completed"\n' > "$FB/fprintd-enroll"
  printf '#!/bin/sh\necho "Verify result: verify-match (done)"\n' > "$FB/fprintd-verify"
  chmod 0755 "$FB"/*
  out=$t/s4.morning.out
  PATH=$FB:$PATH agg "$out" morning --user "$(id -un)" || fail "s4 morning"
  grep -q '^S4 morning: PASS' "$out" || fail "s4 morning: no PASS"
  for r in bridge enrol verify-match verify-nomatch storage persist fprintd; do row "$out" "$r" PASS morning; done
  grep -q '^>>> FINGER: TOUCH NOW with ONE finger.*until ENROLLED' "$out" || fail "s4 morning: the enrol prompt"
  grep -q '^>>> FINGER: SWITCH to a DIFFERENT finger' "$out" || fail "s4 morning: the switch prompt"
  grep -q '^>>> FINGER: after the restart: touch with the ENROLLED finger' "$out" || fail "s4 morning: the persist prompt"
  [[ $(grep -c '^<- MATCH 7\|^    <- MATCH 7' "$out") == 2 ]] || fail "s4 morning: two MATCHes (verify, persist)"
  grep -q '^    <- NOMATCH' "$out" || fail "s4 morning: the NOMATCH"
  grep -q 'ingot-fp-s4-test lock --image' "$out" || fail "s4 morning: the lock step's command"
  grep -c '/dev/tty' "$out" > /dev/null && fail "s4 morning: tried the terminal"
  [[ -S $H/run/omamobile-fp/sock/bridge.sock ]] || fail "s4 morning: the stack is not left running"
  pass "ingot-fp-s4-test morning without a terminal: the finger prompts, every part PASS, the stack left running, the pipe closed"

  out=$t/s4.nofinger2.out
  PATH=$FB:$PATH agg "$out" nofinger --leave-running || fail "s4 nofinger --leave-running"
  grep -q 'LIST still has the enrolled id 7' "$out" || fail "s4 nofinger: LIST after the restart"
  row "$out" fprintd PASS nofinger
  row "$out" leave-running PASS nofinger
  [[ -S $H/run/omamobile-fp/sock/bridge.sock ]] || fail "s4 nofinger --leave-running: the stack is stopped"
  pass "ingot-fp-s4-test nofinger --leave-running: the enrolled id survives the restart, fprintd-list, the stack left running"

  : > "$STATE/data/vendor/omamobile-fp/fail-enroll"
  : > "$STATE/data/vendor/omamobile-fp/hang-list"
  out=$t/s4.morning-fail.out
  PATH=$FB:$PATH agg "$out" morning --user "$(id -un)" && fail "s4 morning with a failing enrolment passed"
  rm -f "$STATE/data/vendor/omamobile-fp/fail-enroll" "$STATE/data/vendor/omamobile-fp/hang-list"
  grep -q '^S4 morning: FAIL (bridge enrol)' "$out" || fail "s4 morning: FAIL names bridge and enrol only"
  row "$out" bridge FAIL morning
  row "$out" enrol FAIL morning
  grep -q 'LIST did not succeed: restarting the stack once' "$out" || fail "s4 morning: no restart after LIST hung"
  grep -q 'restarting the stack so the next one finds it idle' "$out" || fail "s4 morning: the bridge left busy"
  for r in verify-match verify-nomatch persist; do row "$out" "$r" SKIP morning; done
  for r in storage fprintd; do row "$out" "$r" PASS morning; done
  grep -q 'attempt 2 of 2' "$out" || fail "s4 morning: no second attempt"
  grep -q 'ENROLL ended without ENROLLED: ERROR 1' "$out" || fail "s4 morning: the enrolment's end"
  grep -q -- '--- the stack: last 25 lines' "$out" || fail "s4 morning: no stack log at the failure"
  env OMAMOBILE_FP_TEST=1 OMAMOBILE_FP_TEST_ROOT="$H" "$STAGE" stop > /dev/null 2>&1
  [[ ! -e $H/run/omamobile-fp/sock ]] || fail "s4 aggregates: the stack did not stop"
  pass "ingot-fp-s4-test morning, LIST hangs and enrolment fails: the stack restarted, FAIL with the log, the parts after it SKIP or still run, exit 1"
else
  echo "skip - hal with fakes: no gcc -static"
fi

SC=$(command -v shellcheck 2>/dev/null || true)
if [[ -n $SC ]] && "$SC" --version >/dev/null 2>&1; then
  "$SC" -x "$STAGE" "$0" "$HERE/ingot-fp-s4-test" || fail "shellcheck"
  pass "shellcheck"
else
  echo "skip - shellcheck not installed"
fi
