#!/bin/bash
# SPDX-License-Identifier: MIT
# Build a RAM-only Saga probe for `fastboot boot`; never connect to or write a phone.
#
# Usage: tools/build-ingot-probe --kernel Image.gz --dtb sm8475-osom-ingot.dtb \
#          --ssh-key ~/.ssh/id_ed25519.pub --mkbootimg /path/to/mkbootimg.py \
#          --mkdtboimg /path/to/mkdtboimg.py --out /path/to/output [--arch]
#
# --arch packs the shared initramfs/init instead of the RAM-only probe init:
# it boots Arch from userdata and leaves userdata, and only userdata,
# writable (device/ingot/device.conf UFS_RW). Never boot it on a phone whose
# userdata isn't ours to erase.
#
# The kernel must have USB DWC3/QCOM, the eUSB2 PHY, RPMh regulators,
# configfs NCM/ACM and devtmpfs built in (device/ingot/kernel.config).
# No modules or firmware are loaded, and UFS and the remote processors stay
# disabled. ABL takes the device tree only from vendor_boot, so the output is
# boot.img for `fastboot boot` plus vendor_boot.img and dtbo.img for the
# experiment slot (device/ingot/BRINGUP-M1.md).
# mkbootimg.py and its gki/ helpers come from AOSP system/tools/mkbootimg,
# mkdtboimg.py from AOSP system/libufdt (utils/src).
# Docker runs an aarch64 Alpine builder; x86 hosts need a binfmt handler.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
kernel="" dtb="" key="" mkbootimg="" mkdtboimg="" out="" arch_boot=0
die() { echo "error: $*" >&2; exit 1; }
while (($#)); do
  case $1 in
    --kernel) kernel=${2:?}; shift ;;
    --dtb) dtb=${2:?}; shift ;;
    --ssh-key) key=${2:?}; shift ;;
    --mkbootimg) mkbootimg=${2:?}; shift ;;
    --mkdtboimg) mkdtboimg=${2:?}; shift ;;
    --out) out=${2:?}; shift ;;
    --arch) arch_boot=1 ;;
    -h|--help) sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done
command -v docker >/dev/null || die 'Docker is required'
command -v python3 >/dev/null || die 'Python 3 is required'
for path in "$kernel" "$dtb" "$key" "$mkbootimg" "$mkdtboimg"; do
  [[ -n $path && -f $path ]] || die 'supply --kernel, --dtb, --ssh-key, --mkbootimg and --mkdtboimg files'
done
[[ -n $out ]] || die 'supply --out DIR'

# Normalize paths portably (macOS readlink lacks -f on older releases), so
# relative paths and spaces survive Docker's bind mount parsing.
absolute() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
kernel=$(absolute "$kernel") dtb=$(absolute "$dtb") key=$(absolute "$key")
mkbootimg=$(absolute "$mkbootimg") mkdtboimg=$(absolute "$mkdtboimg") out=$(absolute "$out")
for path in "$ROOT" "$kernel" "$dtb" "$key" "$mkbootimg" "$mkdtboimg" "$out"; do
  [[ $path != *,* ]] || die 'Docker bind paths cannot contain commas'
done
[[ $(basename "$mkbootimg") == mkbootimg.py ]] || die '--mkbootimg must name AOSP mkbootimg.py'
[[ $(basename "$mkdtboimg") == mkdtboimg.py ]] || die '--mkdtboimg must name AOSP mkdtboimg.py'
[[ ! -e $out/boot.img ]] || die "$out/boot.img already exists; choose a fresh output directory"
python3 - "$key" <<'PY'
import base64, pathlib, struct, sys
data = pathlib.Path(sys.argv[1]).read_text().split()
if len(data) < 2 or data[0] not in ('ssh-ed25519', 'ssh-rsa', 'ecdsa-sha2-nistp256'):
    sys.exit('--ssh-key must be an OpenSSH PUBLIC key, never a private key')
try:
    raw = base64.b64decode(data[1], validate=True)
    n, = struct.unpack('>I', raw[:4])
    assert raw[4:4+n].decode() == data[0]
except (ValueError, struct.error, AssertionError, UnicodeError):
    sys.exit('invalid SSH public key')
PY

mkdir -p "$out"
docker run --rm --platform linux/arm64 \
  --mount "type=bind,source=$ROOT,target=/src,readonly" \
  --mount "type=bind,source=$kernel,target=/input/kernel,readonly" \
  --mount "type=bind,source=$dtb,target=/input/ingot.dtb,readonly" \
  --mount "type=bind,source=$key,target=/input/key.pub,readonly" \
  --mount "type=bind,source=$(dirname "$mkbootimg"),target=/mkbootimg,readonly" \
  --mount "type=bind,source=$(dirname "$mkdtboimg"),target=/mkdtboimg,readonly" \
  --mount "type=bind,source=$out,target=/out" \
  -e ARCH_BOOT="$arch_boot" \
  alpine:3.22 sh /src/device/ingot/initramfs/build
if ((arch_boot)); then
  echo "Built Arch boot images in $out (no phone was accessed). Booted, they leave userdata writable"
else
  echo "Built boot.img, vendor_boot.img and dtbo.img in $out (no phone was accessed)"
fi
